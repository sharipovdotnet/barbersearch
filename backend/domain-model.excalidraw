      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1041721568,
      "version": 1,
      "versionNonce": 1494581960,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791805714361,
      "link": null,
      "locked": false,
      "text": "Красная рамка — агрегатный корень (7 шт.)   ·   чёрная рамка — дочерняя сущность (6 шт.)\nСплошная стрелка — владение: ребёнок живёт внутри агрегата и меняется только через его методы\nПунктир — ссылка по Id между агрегатами: навигаций нет, наружу торчит только Id\nСерый блок — контекст (папка в BarberSearch.Domain, не отдельная сборка)\n* — добавлено или изменено относительно текущего кода",
      "originalText": "Красная рамка — агрегатный корень (7 шт.)   ·   чёрная рамка — дочерняя сущность (6 шт.)\nСплошная стрелка — владение: ребёнок живёт внутри агрегата и меняется только через его методы\nПунктир — ссылка по Id между агрегатами: навигаций нет, наружу торчит только Id\nСерый блок — контекст (папка в BarberSearch.Domain, не отдельная сборка)\n* — добавлено или изменено относительно текущего кода",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalContainerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 14
    },
