    {
      "id": "lq63zbkw3c0v7u",
      "type": "text",
      "x": 16,
      "y": 64,
      "width": 1208,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
