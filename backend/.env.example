# Шаблон для docker compose: скопируйте в .env (он в .gitignore) и заполните.
#
#   Copy-Item .env.example .env
#
# POSTGRES_PASSWORD обязателен: compose не стартует, пока значение пустое или
# не задано. Это пароль локальной БД, а не боевой секрет; в git он не попадает.
# Пример заполнения: POSTGRES_PASSWORD=<ваш-локальный-пароль>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=barbersearch
POSTGRES_PORT=5432

# MinIO — S3-совместимое хранилище для второго провайдера фото (Storage:Provider=S3).
# Пароль обязателен: без него не стартует сервис minio. Логин по умолчанию —
# MINIO_ROOT_USER=barbersearch. Это локальный пароль dev/CI, а не боевой секрет.
MINIO_ROOT_USER=barbersearch
MINIO_ROOT_PASSWORD=

# Чтобы API писал фото в MinIO, а не на диск, выставьте в окружении процесса API:
#   Storage__Provider=S3
#   Storage__S3__ServiceUrl=http://localhost:9000
#   Storage__S3__Bucket=barbersearch
#   Storage__S3__Region=us-east-1
#   Storage__S3__ForcePathStyle=true
#   Storage__S3__EnsureBucket=true
#   Storage__S3__AccessKey=<MINIO_ROOT_USER>
#   Storage__S3__SecretKey=<MINIO_ROOT_PASSWORD>
#
# Без этих переменных работает локальный провайдер (Storage:Provider=Local) и
# каталог App_Data/photos; MinIO при этом не обязателен.
