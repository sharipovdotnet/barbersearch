# Шаблон для docker compose: скопируйте в .env (он в .gitignore) и заполните.
#
#   Copy-Item .env.example .env
#
# POSTGRES_PASSWORD обязателен: compose не стартует, пока значение пустое или
# не задано. Это пароль локальной БД, а не боевой секрет; в git он не попадает.
# Пример заполнения: POSTGRES_PASSWORD=<ваш-локальный-пароль>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=barbersearch
POSTGRES_PORT=5432
