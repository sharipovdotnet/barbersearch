<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>BarberSearch.Infrastructure.UnitTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <!-- Веб-проект тянет EF Core 10.0.11 через Design; выравниваем версию, чтобы
             ссылка на Web не давала MSB3277 из-за Npgsql/EF 10.0.4. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Domain\BarberSearch.Domain.csproj" />
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Infrastructure.Postgresql\BarberSearch.Infrastructure.Postgresql.csproj" />
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Web\BarberSearch.Web.csproj" />
        <ProjectReference Include="..\..\BarberSearch\src\Shared\Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Боевые настройки логирования веб-слоя: тест читает исходные файлы, поэтому их
             изменение сразу видно тесту, а не только в опубликованном приложении (R-13). -->
        <None Include="..\..\BarberSearch\src\BarberSearch.Web\appsettings.json"
              Link="appsettings.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\BarberSearch\src\BarberSearch.Web\appsettings.Development.json"
              Link="appsettings.Development.json"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
