<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>BarberSearch.IntegrationTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <!-- WAF поднимает реальный хост в памяти; версия совпадает с shared framework 10.0.11. -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
        <!-- Контейнер PostgreSQL на время прогона; образ postgres:18 берётся из локального кэша Docker. -->
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <!-- Web тянет EF Core 10.0.11 через Design; выравниваем версию, чтобы ссылка на Web
             не давала MSB3277 из-за Npgsql/EF 10.0.4 (как в Infrastructure.UnitTests). -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Contracts\BarberSearch.Contracts.csproj" />
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Domain\BarberSearch.Domain.csproj" />
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Infrastructure.Postgresql\BarberSearch.Infrastructure.Postgresql.csproj" />
        <ProjectReference Include="..\..\BarberSearch\src\BarberSearch.Web\BarberSearch.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- appsettings.json нужен тестовому хосту как baseline конфигурации: обязательные
             секции (Auth, DataProtection, ConnectionStrings) переопределяются в TestApp,
             остальные значения берутся из того же файла, что и в проде. -->
        <None Include="..\..\BarberSearch\src\BarberSearch.Web\appsettings.json"
              Link="appsettings.json"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
