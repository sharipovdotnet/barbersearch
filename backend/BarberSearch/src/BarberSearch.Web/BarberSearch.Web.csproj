<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Стабильный id для dotnet user-secrets в Development; сами секреты в git не попадают. -->
        <UserSecretsId>barbersearch-web</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
        <!-- Serilog — единственный логгер приложения: консоль и файл (см. Deployment/SerilogExtensions.cs). -->
        <PackageReference Include="Serilog" Version="3.1.1" />
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
        <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
        <!--
            SkiaSharp — первая нативная зависимость backend: миниатюры и WebP-варианты
            (backend/AGENT.md §17). NativeAssets.Linux.NoDependencies обязателен для
            ubuntu-latest в backend-ci и для контейнера API: без него libSkiaSharp
            не найдётся и генерация упадёт в рантайме, а не на сборке.
        -->
        <PackageReference Include="SkiaSharp" Version="4.156.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Генератор WebP-вариантов и локальное хранилище — internal: их контракт нужен
            только тестам, а не остальному приложению.
        -->
        <InternalsVisibleTo Include="BarberSearch.Infrastructure.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BarberSearch.Domain\BarberSearch.Domain.csproj" />
        <ProjectReference Include="..\BarberSearch.Contracts\BarberSearch.Contracts.csproj" />
        <ProjectReference Include="..\BarberSearch.Application\BarberSearch.Application.csproj" />
        <ProjectReference Include="..\BarberSearch.Infrastructure.Postgresql\BarberSearch.Infrastructure.Postgresql.csproj" />
        <ProjectReference Include="..\BarberSearch.Infrastructure.Email\BarberSearch.Infrastructure.Email.csproj" />
        <ProjectReference Include="..\BarberSearch.Infrastructure.Telegram\BarberSearch.Infrastructure.Telegram.csproj" />
    </ItemGroup>

</Project>
