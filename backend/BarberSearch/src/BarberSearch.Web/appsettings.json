{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Auth": {
    "Issuer": "BarberSearch",
    "Audience": "BarberSearch.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "CookieHours": 8,
    "CookieSameSite": "Lax",
    "ClockSkewSeconds": 30
  },
  "RefreshTokens": {
    "CleanupIntervalMinutes": 60
  },
  "Reminders": {
    "Enabled": false,
    "BatchSize": 100,
    "RetentionDays": 180
  },
  "Telegram": {
    "BotToken": "",
    "BotUsername": "",
    "WebhookSecret": ""
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "BarberSearch",
    "TimeoutSeconds": 5
  },
  "App": {
    "PublicUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "HealthChecks": {
    "DatabaseTimeoutSeconds": 5
  },
  "Deployment": {
    "ShutdownTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "File": {
      "Enabled": true,
      "Path": "logs/barbersearch-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 14,
      "FileSizeLimitMegabytes": 50,
      "Shared": false
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
