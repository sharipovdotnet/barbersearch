{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=barbersearch;Username=postgres;Password=postgres"
  },
  "Auth": {
    "Issuer": "BarberSearch",
    "Audience": "BarberSearch.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "CookieHours": 8,
    "CookieSameSite": "Lax"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "HealthChecks": {
    "DatabaseTimeoutSeconds": 5
  },
  "Deployment": {
    "ShutdownTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
