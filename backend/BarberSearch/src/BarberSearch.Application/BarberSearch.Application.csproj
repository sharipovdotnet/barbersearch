<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Scrutor" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BarberSearch.Contracts\BarberSearch.Contracts.csproj" />
        <ProjectReference Include="..\BarberSearch.Domain\BarberSearch.Domain.csproj" />
        <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Словарь частых паролей для IPasswordPolicy. LogicalName фиксирован: имя ресурса
             не должно зависеть от пути и настроек сборки. Источник: SecLists
             Passwords/Common-Credentials/10k-most-common.txt (MIT). -->
        <EmbeddedResource Include="Users\Passwords\10k-most-common.txt">
            <LogicalName>BarberSearch.Application.Users.Passwords.10k-most-common.txt</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
