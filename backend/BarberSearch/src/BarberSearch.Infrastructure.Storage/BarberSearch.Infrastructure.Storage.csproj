<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.1.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <!--
            SkiaSharp — WebP-варианты фотографий (AGENT.md §17.15). NativeAssets.Linux.NoDependencies
            обязателен для ubuntu-latest в backend-ci и для контейнера API: без него libSkiaSharp
            не найдётся в рантайме, а не на сборке.
        -->
        <PackageReference Include="SkiaSharp" Version="4.156.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Генератор WebP-вариантов, шов объектного хранилища и ключи раскладки — internal:
            их контракт нужен только тестам, а не остальному приложению.
        -->
        <InternalsVisibleTo Include="BarberSearch.Infrastructure.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BarberSearch.Domain\BarberSearch.Domain.csproj" />
        <ProjectReference Include="..\BarberSearch.Application\BarberSearch.Application.csproj" />
        <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

</Project>
