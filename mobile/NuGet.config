<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Локальный NuGet-конфиг мобилки.

    В пользовательском конфиге включён packageSourceMapping со списком пакетов бэкенда:
    MAUI, Xamarin.AndroidX и прочих зависимостей там нет, и восстановление падает с NU1100
    «источники не рассматривались». Здесь для mobile/ всё восстанавливается с nuget.org.

    Конфиг действует только на проекты ниже mobile/ и не переписывает настройки машины,
    поэтому сборка backend/ и frontend/ не меняется.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
