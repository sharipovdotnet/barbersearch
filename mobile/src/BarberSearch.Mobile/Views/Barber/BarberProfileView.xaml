<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="BarberSearch.Mobile.Views.Barber.BarberProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:barber="clr-namespace:BarberSearch.Mobile.Views.Barber"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels.Barber;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:BarberCabinetProfileViewModel">

    <!--
        Раздел «Профиль»: карточка, фотографии, прайс и специализации.
        Правка — отдельные экраны поверх кабинета, поэтому раздел не держит полей ввода:
        он показывает агрегат и переходит по маршруту. Сетка фото только показывает кадры,
        а загрузка, подпись, порядок и публикация живут на экране одного фото.

        Правка профиля и услуги — зарегистрированные дочерние страницы: раздел передаёт
        им параметры и гасит себя перед переходом, а маршруты живут в AppShell.

        Состояния (первое чтение, ошибка, отказ, список) лежат в одном месте и
        показываются взаимоисключающе; пустые блоки (bio, правило опозданий) не
        превращаются в заголовок с пустой строкой.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,24" Spacing="12">

            <!-- Первое чтение карточки. -->
            <VerticalStackLayout
                IsVisible="{Binding IsFirstLoading}"
                Padding="0,24"
                Spacing="8">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsFirstLoading}" />
                <Label
                    HorizontalTextAlignment="Center"
                    Text="{loc:Translate Key='Загружаем профиль…'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            </VerticalStackLayout>

            <!-- Тихое обновление уже показанной карточки. -->
            <HorizontalStackLayout IsVisible="{Binding IsRefreshing}" Spacing="8">
                <ActivityIndicator
                    IsRunning="{Binding IsRefreshing}"
                    IsVisible="{Binding IsRefreshing}"
                    VerticalOptions="Center" />
                <Label
                    Text="{loc:Translate Key='Обновляем профиль…'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Чтение не удалось: причина и строка автоповтора. -->
            <Border
                Padding="16"
                IsVisible="True"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 10">
                <Border.Triggers>
                    <DataTrigger
                        Binding="{Binding ErrorMessage}"
                        TargetType="Border"
                        Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <DataTrigger
                        Binding="{Binding IsFirstLoading}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <!--
                        Тихая попытка могла не дойти до сервера уже после успешного чтения:
                        карточка остаётся на экране, и полноэкранная причина противоречила бы
                        ей. Повтор продолжается без баннера.
                    -->
                    <DataTrigger
                        Binding="{Binding IsReady}"
                        TargetType="Border"
                        Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Не удалось загрузить профиль'}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsAutoRetrying}"
                        Text="{loc:Translate Key='Пробуем снова…'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Карточка принадлежит другому аккаунту: повтор не поможет. -->
            <Border
                Padding="16"
                IsVisible="{Binding IsForbidden}"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Нет доступа к профилю'}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Карточка принадлежит другому аккаунту.'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Профиль удалён или ещё не создан. -->
            <Border
                Padding="16"
                IsVisible="{Binding IsNotFound}"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Профиль не найден'}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Профиль мастера удалён или ещё не создан.'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Сессии больше нет: форма входа живёт на вкладке «Профиль». -->
            <Border
                Padding="16"
                IsVisible="{Binding IsSignInRequired}"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Войдите, чтобы увидеть профиль'}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Сеанс истёк. Войдите заново.'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    <Button
                        Clicked="OnSignInClicked"
                        HorizontalOptions="Center"
                        Text="{loc:Translate Key='Войти'}" />
                </VerticalStackLayout>
            </Border>

            <!-- Карточка прочитана: сам раздел. -->
            <VerticalStackLayout IsVisible="{Binding IsReady}" Spacing="12">

                <!--
                    Баннер проверки: пока профиль не подтверждён, карточки нет в поиске.
                    Он исчезает сам, когда администратор подтвердил профиль.
                -->
                <Border
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10">
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding IsVerified}"
                            TargetType="Border"
                            Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding VerificationHint}" />
                </Border>

                <!-- Публичная карточка и её ссылка: действия над готовым профилем. -->
                <FlexLayout
                    AlignItems="Center"
                    Direction="Row"
                    Wrap="Wrap">
                    <Button
                        Margin="0,0,8,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Command="{Binding PreviewCommand}"
                        IsVisible="{Binding CanPreviewPublic}"
                        Text="{loc:Translate Key='Открыть, как видят клиенты'}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                    <Button
                        Margin="0,0,8,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Command="{Binding ShareCommand}"
                        IsVisible="{Binding CanPreviewPublic}"
                        Text="{loc:Translate Key='Поделиться профилем'}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                </FlexLayout>

                <!-- Карточка мастера. -->
                <Border
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="12">

                        <!--
                            Личность: аватар 88×88, имя, грейд и состояние проверки фото.
                            Инициалы лежат под картинкой и остаются, пока кадр не прочитан,
                            отклонён или скрыт: пустого круга не бывает (см. RefreshAvatarImageAsync).
                        -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                HeightRequest="88"
                                Padding="0"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 44"
                                StrokeThickness="0"
                                VerticalOptions="Start"
                                WidthRequest="88">
                                <Grid>
                                    <Label
                                        FontFamily="GeistSemiBold"
                                        FontSize="24"
                                        HorizontalOptions="Center"
                                        Text="{Binding Initials}"
                                        VerticalOptions="Center" />
                                    <Image
                                        x:Name="AvatarImage"
                                        Aspect="AspectFill"
                                        IsVisible="False">
                                        <Image.Clip>
                                            <EllipseGeometry
                                                Center="44,44"
                                                RadiusX="44"
                                                RadiusY="44" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Start">
                                <Label
                                    FontFamily="GeistSemiBold"
                                    FontSize="18"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding DisplayName}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding GradeText}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                                <!-- Состояние проверки фото: цвет повторяет бейджи кадров портфолио. -->
                                <Border
                                    Padding="8,2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding HasAvatarStatus}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 6">
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding AvatarStatusText}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding AvatarStatusKind}"
                                                TargetType="Label"
                                                Value="pending">
                                                <Setter
                                                    Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding AvatarStatusKind}"
                                                TargetType="Label"
                                                Value="rejected">
                                                <Setter
                                                    Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <!-- Фото скрыто администратором: кадр не показывается, причина на месте. -->
                                <Label
                                    FontFamily="GeistMedium"
                                    FontSize="12"
                                    IsVisible="{Binding IsAvatarBlocked}"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding AvatarBlockedText}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding IsAvatarBlocked}"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding AvatarBlockedHint}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                                <!-- Причина отказа модератора: видна рядом с бейджем. -->
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding HasAvatarRejection}"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding AvatarRejectionText}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!--
                            Аватар: файл выбирает ViewModel, экран только показывает кадр и
                            спрашивает подтверждение удаления. Подпись объясняет, кто видит фото.
                        -->
                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Фото профиля видят вы и администратор. У барбера оно показывается в открытой карточке.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <FlexLayout
                            AlignItems="Center"
                            Direction="Row"
                            Wrap="Wrap">
                            <Button
                                Margin="0,0,8,8"
                                Command="{Binding ChangeAvatarCommand}"
                                IsEnabled="{Binding CanChangeAvatar}"
                                Text="{Binding AvatarActionText}" />
                            <Button
                                Margin="0,0,8,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                Clicked="OnDeleteAvatarClicked"
                                IsEnabled="{Binding CanChangeAvatar}"
                                IsVisible="{Binding CanDeleteAvatar}"
                                Text="{loc:Translate Key='Удалить'}"
                                TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                            <ActivityIndicator
                                Margin="0,0,8,8"
                                IsRunning="{Binding IsAvatarUploading}"
                                IsVisible="{Binding IsAvatarUploading}"
                                VerticalOptions="Center" />
                        </FlexLayout>

                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='JPEG, PNG или WebP до 5 МБ.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <!-- Ошибка действия с аватаром: строка появляется только по факту отказа. -->
                        <Label
                            FontSize="12"
                            IsVisible="{Binding AvatarError, Converter={StaticResource NotNull}}"
                            LineBreakMode="WordWrap"
                            Text="{Binding AvatarError}"
                            TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                        <!-- Успех: загрузка принята или фото удалено. -->
                        <Label
                            FontSize="12"
                            IsVisible="{Binding AvatarAnnouncement, Converter={StaticResource NotNull}}"
                            LineBreakMode="WordWrap"
                            Text="{Binding AvatarAnnouncement}"
                            TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />

                        <!-- Рейтинг и отзывы: те же строки, что на публичной карточке. -->
                        <FlexLayout
                            AlignItems="Center"
                            Direction="Row"
                            Wrap="Wrap">
                            <Label
                                Margin="0,0,8,4"
                                FontFamily="GeistMedium"
                                FontSize="16"
                                Text="{Binding RatingText}" />
                            <Label
                                Margin="0,0,0,4"
                                FontSize="12"
                                Text="{Binding ReviewsText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                VerticalTextAlignment="Center" />
                        </FlexLayout>

                        <!-- Грейд меняет администратор, поэтому здесь только чтение. -->
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="6">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Стаж'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label Grid.Column="1" Text="{Binding ExperienceText}" />
                            <Label
                                Grid.Row="1"
                                FontSize="12"
                                Text="{loc:Translate Key='Языки'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding LanguagesText}" />
                            <Label
                                Grid.Row="2"
                                FontSize="12"
                                Text="{loc:Translate Key='Оплата'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding PaymentMethodsText}" />
                        </Grid>

                        <!-- О себе: пустой текст не превращается в заголовок с прочерком. -->
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding Bio}"
                                    TargetType="VerticalStackLayout"
                                    Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='О себе'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                LineBreakMode="WordWrap"
                                Text="{Binding Bio}" />
                        </VerticalStackLayout>

                        <!-- Правило опозданий: необязательное поле, поэтому блок скрывается. -->
                        <VerticalStackLayout Spacing="2">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger
                                    Binding="{Binding LatePolicyText}"
                                    TargetType="VerticalStackLayout"
                                    Value="">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Правило опозданий'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                LineBreakMode="WordWrap"
                                Text="{Binding LatePolicyText}" />
                        </VerticalStackLayout>

                        <Button
                            Command="{Binding RequestEditCommand}"
                            HorizontalOptions="Start"
                            Text="{loc:Translate Key='Редактировать профиль'}" />

                        <!-- Свежесть карточки: время последнего чтения. -->
                        <Label
                            FontSize="12"
                            Text="{Binding UpdatedAtText}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Фотографии: загрузка, порядок, подпись и публикация — как в вебе. -->
                <Border
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="GeistSemiBold"
                                FontSize="16"
                                Text="{loc:Translate Key='Фотографии'}"
                                VerticalTextAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Clicked="OnAddPhotoClicked"
                                IsEnabled="{Binding CanAddPhoto}"
                                Text="{loc:Translate Key='Добавить фото'}" />
                        </Grid>

                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Работы видны в вашей карточке. Первое фото показывается первым.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <!-- Предел портфолио: кнопка добавления гаснет, а строка объясняет почему. -->
                        <Label
                            FontSize="12"
                            IsVisible="{Binding IsPhotoLimitReached}"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='В портфолио уже 10 фото. Удалите одно, чтобы добавить новое.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <Label
                            FontSize="12"
                            IsVisible="True"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Фотографий нет. Добавьте работы, чтобы клиенты видели ваш стиль.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasPhotos}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- Фото открывается нажатием: подсказка нужна только при непустой сетке. -->
                        <Label
                            FontSize="12"
                            IsVisible="False"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Нажмите на фото, чтобы изменить его.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasPhotos}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!--
                            Сетка портфолио — по два кадра в строке, как sm:grid-cols-2 кабинета
                            веба: карточка кадра, квадратное превью, подпись до двух строк и
                            бейдж состояния проверки. Ширину плитки считает код раздела от
                            ширины хоста (см. BarberProfileView.xaml.cs), поэтому две плитки
                            занимают строку целиком, а подпись и статус не обрезаются.
                            Отступ между строками — 12 pt нижнего Padding обёртки-Grid, а не
                            Margin плитки: FlexLayout считает Margin элемента дважды (в
                            DesiredSize и ещё раз в строке) и превращал 12 pt в 24 pt. Padding
                            входит в высоту содержимого один раз, поэтому зазор совпадает с
                            горизонтальным gap-3 веба.
                        -->
                        <FlexLayout
                            x:Name="PhotoTilesHost"
                            AlignItems="Start"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="barber:BarberProfilePhotoTile">
                                    <Grid Padding="0,0,0,12">
                                        <Border
                                            Padding="8"
                                            Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                                            StrokeShape="RoundRectangle 10"
                                            WidthRequest="{Binding TileWidth}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnPhotoTapped" />
                                            </Border.GestureRecognizers>

                                            <VerticalStackLayout Spacing="8">
                                                <Border
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                                    HeightRequest="{Binding ImageSize}"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Image
                                                        Aspect="AspectFill"
                                                        HeightRequest="{Binding ImageSize}"
                                                        SemanticProperties.Description="{Binding Caption}"
                                                        Source="{Binding Image}" />
                                                </Border>

                                                <Label
                                                    FontSize="14"
                                                    LineBreakMode="WordWrap"
                                                    MaxLines="2"
                                                    Text="{Binding Caption}" />

                                                <!-- Состояние проверки: цвет повторяет бейджи записей. -->
                                                <Border
                                                    Padding="8,2"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                                    HorizontalOptions="Start"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        FontSize="12"
                                                        LineBreakMode="WordWrap"
                                                        MaxLines="2"
                                                        Text="{Binding StatusText}"
                                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}">
                                                        <Label.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding StatusKind}"
                                                                TargetType="Label"
                                                                Value="pending">
                                                                <Setter
                                                                    Property="TextColor"
                                                                    Value="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusKind}"
                                                                TargetType="Label"
                                                                Value="rejected">
                                                                <Setter
                                                                    Property="TextColor"
                                                                    Value="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Прайс: цена и длительность, скрытие и возврат. -->
                <Border
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                FontFamily="GeistSemiBold"
                                FontSize="16"
                                Text="{loc:Translate Key='Услуги'}"
                                VerticalTextAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding RequestAddServiceCommand}"
                                Text="{loc:Translate Key='Добавить услугу'}" />
                        </Grid>

                        <Label
                            FontSize="12"
                            IsVisible="True"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Услуги пока не добавлены.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasServices}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberServiceItem">
                                    <Border
                                        Padding="12"
                                        Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                                        StrokeShape="RoundRectangle 10">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label
                                                    FontFamily="GeistMedium"
                                                    FontSize="14"
                                                    LineBreakMode="WordWrap"
                                                    Text="{Binding Name}" />
                                                <Label
                                                    Grid.Column="1"
                                                    Text="{Binding PriceText}" />
                                            </Grid>
                                            <FlexLayout
                                                AlignItems="Center"
                                                Direction="Row"
                                                Wrap="Wrap">
                                                <Border
                                                    Margin="0,0,8,4"
                                                    Padding="8,2"
                                                    BackgroundColor="Transparent"
                                                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding CategoryText}"
                                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                                </Border>
                                                <Label
                                                    Margin="0,0,8,4"
                                                    FontSize="12"
                                                    Text="{Binding DurationText}"
                                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                                    VerticalTextAlignment="Center" />
                                                <Border
                                                    Margin="0,0,8,4"
                                                    Padding="8,2"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                                    IsVisible="{Binding IsHidden}"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 8">
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding StatusText}" />
                                                </Border>
                                            </FlexLayout>
                                            <FlexLayout
                                                AlignItems="Center"
                                                Direction="Row"
                                                Wrap="Wrap">
                                                <Button
                                                    Margin="0,0,8,8"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                                    Clicked="OnEditServiceClicked"
                                                    IsVisible="{Binding IsActive}"
                                                    Text="{loc:Translate Key='Изменить'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                                                <Button
                                                    Margin="0,0,8,8"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                                    Clicked="OnHideServiceClicked"
                                                    IsVisible="{Binding IsActive}"
                                                    Text="{loc:Translate Key='Скрыть'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                                                <Button
                                                    Margin="0,0,8,8"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                                    Clicked="OnRestoreServiceClicked"
                                                    IsVisible="{Binding IsHidden}"
                                                    Text="{loc:Translate Key='Вернуть'}"
                                                    TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!--
                    Ошибка записи: одна на раздел, потому что ViewModel хранит одну.
                    Строка стоит между прайсом и специализациями — рядом с обоими блоками.
                -->
                <Label
                    FontSize="12"
                    IsVisible="True"
                    LineBreakMode="WordWrap"
                    Text="{Binding ActionError}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding ActionError}"
                            TargetType="Label"
                            Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <!-- Специализации: список и ленивый справочник. -->
                <Border
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Специализации'}" />

                        <Label
                            FontSize="12"
                            IsVisible="True"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Специализаций нет. По тегам вас не найдут в фильтре поиска.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding HasSpecializations}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Specializations}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberSpecializationItem">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontFamily="GeistMedium"
                                                FontSize="14"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Name}" />
                                            <Label
                                                FontSize="12"
                                                IsVisible="{Binding HasDescription}"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Description}"
                                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                            Clicked="OnRemoveSpecializationClicked"
                                            Text="{loc:Translate Key='Убрать'}"
                                            TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Открыть пикер: справочник читается только по этому нажатию. -->
                        <Button
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                            Command="{Binding OpenSpecializationPickerCommand}"
                            HorizontalOptions="Start"
                            IsVisible="True"
                            Text="{loc:Translate Key='Добавить специализацию'}"
                            TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSpecializationPickerOpen}"
                                    TargetType="Button"
                                    Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <VerticalStackLayout IsVisible="{Binding IsSpecializationPickerOpen}" Spacing="8">
                            <HorizontalStackLayout IsVisible="{Binding IsSpecializationLoading}" Spacing="8">
                                <ActivityIndicator
                                    IsRunning="{Binding IsSpecializationLoading}"
                                    IsVisible="{Binding IsSpecializationLoading}"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{loc:Translate Key='Загружаем справочник…'}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Справочник не ответил: причина и строка автоповтора, без кнопки. -->
                            <VerticalStackLayout IsVisible="True" Spacing="8">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger
                                        Binding="{Binding SpecializationError}"
                                        TargetType="VerticalStackLayout"
                                        Value="{x:Null}">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                                <Label
                                    LineBreakMode="WordWrap"
                                    Text="{Binding SpecializationError}"
                                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding IsSpecializationAutoRetrying}"
                                    Text="{loc:Translate Key='Пробуем снова…'}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding HasAvailableSpecializations}" Spacing="8">
                                <Picker
                                    x:Name="SpecializationPicker"
                                    ItemsSource="{Binding AvailableSpecializations}"
                                    SelectedIndexChanged="OnSpecializationSelected"
                                    Title="{loc:Translate Key='Выберите специализацию'}" />
                                <Button
                                    x:Name="AddSpecializationButton"
                                    Clicked="OnAddSpecializationClicked"
                                    IsEnabled="False"
                                    Text="{loc:Translate Key='Добавить'}" />
                            </VerticalStackLayout>

                            <Button
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                Clicked="OnCloseSpecializationPickerClicked"
                                Command="{Binding CloseSpecializationPickerCommand}"
                                HorizontalOptions="Start"
                                Text="{loc:Translate Key='Отмена'}"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
