<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Семантические токены веб-клиента: frontend/src/index.css, блоки :root и .dark.
        Имена повторяют CSS-переменные веба, меняется только разделитель: переменная
        muted-foreground здесь MutedForeground.

        Значения — те же oklch, переведённые в sRGB: MAUI не разбирает oklch(), а hex
        переносит цвет без потерь. Конвертация проверена по контрасту, а не на глаз:
        Destructive (#CE0000) даёт 5.79:1 на белом, ровно как записано в index.css:71-74
        для issue #34. Если в вебе меняется токен, здесь меняется то же значение — и только оно.

        Пара на тему: имя без суффикса — светлая тема, с суффиксом Dark — тёмная.
        На месте использования тему выбирает AppThemeBinding. Других цветов в приложении
        нет: любой оттенок, которого нет в index.css, — баг (AGENT.md §8.3).

        Полупрозрачные токены веба записаны восемью знаками ARGB: border = oklch(1 0 0 / 10%)
        → #1AFFFFFF, input = 15% → #26FFFFFF. Осветлять их поверх фона не нужно: прозрачность
        и есть значение токена.

        Шкала радиусов веба: 0.625rem = 10 → sm 6, md 8, lg 10, xl 14.
    -->

    <!-- Светлая тема (:root) -->
    <Color x:Key="Background">#FFFFFF</Color>
    <Color x:Key="Foreground">#0A0A0A</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="CardForeground">#0A0A0A</Color>
    <Color x:Key="Popover">#FFFFFF</Color>
    <Color x:Key="PopoverForeground">#0A0A0A</Color>
    <Color x:Key="Primary">#171717</Color>
    <Color x:Key="PrimaryForeground">#FAFAFA</Color>
    <Color x:Key="Secondary">#F5F5F5</Color>
    <Color x:Key="SecondaryForeground">#171717</Color>
    <Color x:Key="Muted">#F5F5F5</Color>
    <!-- 0.54, а не 0.556: порог AA 4.5:1 на Muted (index.css:66-68, issue #33). -->
    <Color x:Key="MutedForeground">#6F6F6F</Color>
    <Color x:Key="Accent">#F5F5F5</Color>
    <Color x:Key="AccentForeground">#171717</Color>
    <Color x:Key="Destructive">#CE0000</Color>
    <!--
        Заливка счётчиков: в вебе отдельный токен, потому что destructive — цвет текста
        на тёмном фоне, а залитый кружок красный в обеих темах (index.css:75-79, issue #93).
        В .dark не переопределяется.
    -->
    <Color x:Key="DestructiveSolid">#CE0000</Color>
    <Color x:Key="Success">#0B7643</Color>
    <Color x:Key="Warning">#975800</Color>
    <Color x:Key="Border">#E5E5E5</Color>
    <Color x:Key="Input">#E5E5E5</Color>
    <Color x:Key="Ring">#A1A1A1</Color>

    <!-- Тёмная тема (.dark) -->
    <Color x:Key="BackgroundDark">#0A0A0A</Color>
    <Color x:Key="ForegroundDark">#FAFAFA</Color>
    <Color x:Key="CardDark">#171717</Color>
    <Color x:Key="CardForegroundDark">#FAFAFA</Color>
    <Color x:Key="PopoverDark">#171717</Color>
    <Color x:Key="PopoverForegroundDark">#FAFAFA</Color>
    <Color x:Key="PrimaryDark">#E5E5E5</Color>
    <Color x:Key="PrimaryForegroundDark">#171717</Color>
    <Color x:Key="SecondaryDark">#262626</Color>
    <Color x:Key="SecondaryForegroundDark">#FAFAFA</Color>
    <Color x:Key="MutedDark">#262626</Color>
    <Color x:Key="MutedForegroundDark">#A1A1A1</Color>
    <Color x:Key="AccentDark">#262626</Color>
    <Color x:Key="AccentForegroundDark">#FAFAFA</Color>
    <Color x:Key="DestructiveDark">#FF6467</Color>
    <Color x:Key="DestructiveSolidDark">#CE0000</Color>
    <Color x:Key="SuccessDark">#54CC8E</Color>
    <Color x:Key="WarningDark">#EFB656</Color>
    <Color x:Key="BorderDark">#1AFFFFFF</Color>
    <Color x:Key="InputDark">#26FFFFFF</Color>
    <Color x:Key="RingDark">#737373</Color>

</ResourceDictionary>
