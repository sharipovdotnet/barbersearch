<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:addr="clr-namespace:BarberSearch.Contracts.Addresses.SuggestCities;assembly=BarberSearch.Contracts"
    xmlns:search="clr-namespace:BarberSearch.Contracts.BarberProfiles.SearchBarbers;assembly=BarberSearch.Contracts"
    xmlns:controls="clr-namespace:BarberSearch.Mobile.Controls"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:SearchViewModel"
    Title="{loc:Translate Key='Поиск'}">

    <!-- Заголовок навигации: ножницы перед названием раздела, как логотип в шапке веба. -->
    <Shell.TitleView>
        <controls:BrandTitleView Text="{loc:Translate Key='Поиск'}" />
    </Shell.TitleView>

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="16" Spacing="16">

            <!--
                Шапка раздела: логотип веба (ножницы + имя) вместо пустого верха над формой.
                Знак берётся из ScissorsMark — тот же контур, что в site-header.tsx, но крупнее
                и в плашке Primary: на телефоне 16 pt из шапки сайта потерялись бы. Подпись —
                заголовок витрины (home-hero.tsx), а не новая строка.
            -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    HeightRequest="48"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10"
                    VerticalOptions="Center"
                    WidthRequest="48">
                    <controls:ScissorsMark StrokeColor="{AppThemeBinding Light={StaticResource PrimaryForeground}, Dark={StaticResource PrimaryForegroundDark}}" />
                </Border>
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="24"
                        Text="Hairo" />
                    <Label
                        FontSize="12"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Найди мастера и запишись за минуту'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </Grid>

            <!--
                Форма поиска: те же шесть фильтров, что на витрине веба, разложенные под палец.
                Справочники приходят из API, поэтому их селекты ждут загрузки и умеют «Повторить».
            -->
            <Border Padding="16" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="2">
                        <Label
                            FontSize="12"
                            Text="{loc:Translate Key='Город салона'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Entry
                            x:Name="CityEntry"
                            Placeholder="{loc:Translate Key='Москва'}"
                            ReturnCommand="{Binding SearchCommand}"
                            Text="{Binding City}" />

                        <!--
                            Подсказки города — строки прямо под полем: у MAUI нет нативного
                            комбобокса, а выпадающее окно пришлось бы рисовать вручную поверх
                            формы. Строка 44 pt: палец попадает с первого раза, как у карточек.
                        -->
                        <Border
                            Margin="0,4,0,0"
                            IsVisible="{Binding CitySuggestions.IsVisible}"
                            Padding="0"
                            StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CitySuggestions.Items}" Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="addr:CitySuggestionResponse">
                                            <Label
                                                Padding="12,12"
                                                FontSize="16"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Display}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnCitySuggestionTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Пустой ответ — не ошибка: текст веба, а поле остаётся вводом. -->
                                <Label
                                    Padding="12,12"
                                    FontSize="14"
                                    IsVisible="{Binding CitySuggestions.IsEmpty}"
                                    Text="{loc:Translate Key='Ничего не найдено.'}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Дата'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchDateOption}"
                                ItemsSource="{Binding Dates}"
                                SelectedItem="{Binding SelectedDate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Язык'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchLanguageOption}"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!--
                        Справочники стоят в столбик: пустой справочник скрывает свой селект
                        (как в вебе), и в двухколоночной сетке на его месте осталась бы дыра.
                    -->
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout IsVisible="{Binding ShowSpecializationPicker}" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Специализация'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                IsEnabled="{Binding IsCatalogsEnabled}"
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchCatalogOption}"
                                ItemsSource="{Binding Specializations}"
                                SelectedItem="{Binding SelectedSpecialization}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowHairServicePicker}" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Услуга'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                IsEnabled="{Binding IsCatalogsEnabled}"
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchCatalogOption}"
                                ItemsSource="{Binding HairServices}"
                                SelectedItem="{Binding SelectedHairService}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label
                            FontSize="12"
                            Text="{loc:Translate Key='Дополнительная услуга'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Entry
                            Placeholder="{loc:Translate Key='Например, борода'}"
                            ReturnCommand="{Binding SearchCommand}"
                            Text="{Binding AdditionalService}" />
                    </VerticalStackLayout>

                    <!-- Ошибка справочников не блокирует город, дату и язык: эти поля работают и так. -->
                    <Border
                        IsVisible="{Binding HasCatalogsError}"
                        Padding="12"
                        Stroke="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}"
                        StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                LineBreakMode="WordWrap"
                                Text="{Binding CatalogsErrorText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Button
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                Command="{Binding RetryCatalogsCommand}"
                                Text="{loc:Translate Key='Повторить'}"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Command="{Binding SearchCommand}" Text="{loc:Translate Key='Найти'}" />
                </VerticalStackLayout>
            </Border>

            <!-- Выдача: заголовок, счётчик, индикатор, ошибка и карточки. -->
            <VerticalStackLayout x:Name="ResultsSection" Spacing="8">
                <Label
                    FontFamily="GeistSemiBold"
                    FontSize="16"
                    Text="{loc:Translate Key='Мастера рядом'}" />

                <Label
                    FontSize="12"
                    IsVisible="{Binding ShowResultsCount}"
                    Text="{Binding ResultsCountText}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!-- Порядок выдачи меняется геопозицией, и экран говорит об этом прямо. -->
                <Label
                    FontSize="12"
                    IsVisible="{Binding ShowNearbySort}"
                    Text="{loc:Translate Key='Сначала ближайшие мастера'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!--
                    Чтение геопозиции идёт до запроса выдачи: подпись объясняет, почему «Найти»
                    отвечает не сразу. Свой индикатор не нужен — основной уже вращается.
                -->
                <Label
                    FontSize="12"
                    IsVisible="{Binding IsLocating}"
                    Text="{loc:Translate Key='Определяем геопозицию…'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <ActivityIndicator
                    HorizontalOptions="Start"
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}" />

                <!-- Отказ в геопозиции не блокирует поиск: подсказка объясняет порядок и даёт повтор. -->
                <Border
                    IsVisible="{Binding HasLocationHint}"
                    Padding="12"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            LineBreakMode="WordWrap"
                            Text="{Binding LocationHint}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Button
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                            Command="{Binding RetryLocationCommand}"
                            Text="{loc:Translate Key='Повторить'}"
                            TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="8">
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Command="{Binding SearchCommand}"
                        Text="{loc:Translate Key='Повторить'}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Barbers}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="search:BarberSearchItemResponse">
                            <Border Padding="12" StrokeShape="RoundRectangle 10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnBarberTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        FontFamily="GeistSemiBold"
                                        FontSize="16"
                                        Text="{Binding DisplayName}" />
                                    <Label Text="{Binding PrimarySalonName}" />
                                    <Label
                                        Text="{Binding City}"
                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                                    <!-- Рейтинг слева, расстояние справа; без геопозиции расстояние скрыто. -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Rating, Converter={StaticResource RatingText}}" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            IsVisible="{Binding DistanceKm, Converter={StaticResource NotNull}}"
                                            Text="{Binding DistanceKm, Converter={StaticResource DistanceText}}"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!--
                    Пустое состояние: подсказка зависит от последних отправленных фильтров.
                    Коробка повторяет пустую выдачу веба (barber-results.tsx): пунктирная
                    рамка, кружок Muted со знаком и текст по центру. Знак — ножницы шапки:
                    в вебе здесь лупа Search, но пустому экрану на телефоне нужен бренд,
                    а не второй «поиск» рядом с кнопкой «Найти».
                -->
                <Border
                    Margin="0,24,0,0"
                    Padding="24,40"
                    IsVisible="{Binding ShowEmptyState}"
                    StrokeDashArray="4,4"
                    StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="12">
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                            HeightRequest="48"
                            HorizontalOptions="Center"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 24"
                            WidthRequest="48">
                            <controls:ScissorsMark StrokeColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        </Border>
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontFamily="GeistMedium"
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                IsVisible="{Binding HasEmptyTitle}"
                                LineBreakMode="WordWrap"
                                Text="{Binding EmptyTitle}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                Text="{Binding EmptyDescription}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
