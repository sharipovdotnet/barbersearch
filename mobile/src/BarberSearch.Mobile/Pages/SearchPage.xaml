<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:search="clr-namespace:BarberSearch.Contracts.BarberProfiles.SearchBarbers;assembly=BarberSearch.Contracts"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:SearchViewModel"
    Title="{loc:Translate Key='Поиск'}">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="16" Spacing="16">

            <!--
                Форма поиска: те же шесть фильтров, что на витрине веба, разложенные под палец.
                Справочники приходят из API, поэтому их селекты ждут загрузки и умеют «Повторить».
            -->
            <Border Padding="16" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="2">
                        <Label
                            FontSize="12"
                            Text="{loc:Translate Key='Город салона'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Entry
                            Placeholder="{loc:Translate Key='Москва'}"
                            ReturnCommand="{Binding SearchCommand}"
                            Text="{Binding City}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Дата'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchDateOption}"
                                ItemsSource="{Binding Dates}"
                                SelectedItem="{Binding SelectedDate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Язык'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchLanguageOption}"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!--
                        Справочники стоят в столбик: пустой справочник скрывает свой селект
                        (как в вебе), и в двухколоночной сетке на его месте осталась бы дыра.
                    -->
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout IsVisible="{Binding ShowSpecializationPicker}" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Специализация'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                IsEnabled="{Binding IsCatalogsEnabled}"
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchCatalogOption}"
                                ItemsSource="{Binding Specializations}"
                                SelectedItem="{Binding SelectedSpecialization}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding ShowHairServicePicker}" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Услуга'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Picker
                                IsEnabled="{Binding IsCatalogsEnabled}"
                                ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:SearchCatalogOption}"
                                ItemsSource="{Binding HairServices}"
                                SelectedItem="{Binding SelectedHairService}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label
                            FontSize="12"
                            Text="{loc:Translate Key='Дополнительная услуга'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Entry
                            Placeholder="{loc:Translate Key='Например, борода'}"
                            ReturnCommand="{Binding SearchCommand}"
                            Text="{Binding AdditionalService}" />
                    </VerticalStackLayout>

                    <!-- Ошибка справочников не блокирует город, дату и язык: эти поля работают и так. -->
                    <Border
                        IsVisible="{Binding HasCatalogsError}"
                        Padding="12"
                        Stroke="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}"
                        StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                LineBreakMode="WordWrap"
                                Text="{Binding CatalogsErrorText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Button
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                Command="{Binding RetryCatalogsCommand}"
                                Text="{loc:Translate Key='Повторить'}"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Command="{Binding SearchCommand}" Text="{loc:Translate Key='Найти'}" />
                </VerticalStackLayout>
            </Border>

            <!-- Выдача: заголовок, счётчик, индикатор, ошибка и карточки. -->
            <VerticalStackLayout x:Name="ResultsSection" Spacing="8">
                <Label
                    FontFamily="GeistSemiBold"
                    FontSize="16"
                    Text="{loc:Translate Key='Барберы рядом'}" />

                <Label
                    FontSize="12"
                    IsVisible="{Binding ShowResultsCount}"
                    Text="{Binding ResultsCountText}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!-- Порядок выдачи меняется геопозицией, и экран говорит об этом прямо. -->
                <Label
                    FontSize="12"
                    IsVisible="{Binding ShowNearbySort}"
                    Text="{loc:Translate Key='Сначала ближайшие мастера'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!--
                    Чтение геопозиции идёт до запроса выдачи: индикатор и подпись объясняют,
                    почему «Найти» отвечает не сразу.
                -->
                <HorizontalStackLayout IsVisible="{Binding IsLocating}" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsLocating}" VerticalOptions="Center" />
                    <Label
                        FontSize="12"
                        Text="{loc:Translate Key='Определяем геопозицию…'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <ActivityIndicator
                    HorizontalOptions="Start"
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}" />

                <!-- Отказ в геопозиции не блокирует поиск: подсказка объясняет порядок и даёт повтор. -->
                <Border
                    IsVisible="{Binding HasLocationHint}"
                    Padding="12"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            LineBreakMode="WordWrap"
                            Text="{Binding LocationHint}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Button
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                            Command="{Binding RetryLocationCommand}"
                            Text="{loc:Translate Key='Повторить'}"
                            TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="8">
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Command="{Binding SearchCommand}"
                        Text="{loc:Translate Key='Повторить'}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Barbers}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="search:BarberSearchItemResponse">
                            <Border Padding="12" StrokeShape="RoundRectangle 10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnBarberTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        FontFamily="GeistSemiBold"
                                        FontSize="16"
                                        Text="{Binding DisplayName}" />
                                    <Label Text="{Binding PrimarySalonName}" />
                                    <Label
                                        Text="{Binding City}"
                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                                    <!-- Рейтинг слева, расстояние справа; без геопозиции расстояние скрыто. -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Rating, Converter={StaticResource RatingText}}" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="12"
                                            IsVisible="{Binding DistanceKm, Converter={StaticResource NotNull}}"
                                            Text="{Binding DistanceKm, Converter={StaticResource DistanceText}}"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Пустое состояние: подсказка зависит от последних отправленных фильтров. -->
                <VerticalStackLayout
                    Margin="0,24,0,0"
                    IsVisible="{Binding ShowEmptyState}"
                    Spacing="8">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding HasEmptyTitle}"
                        LineBreakMode="WordWrap"
                        Text="{Binding EmptyTitle}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding EmptyDescription}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
