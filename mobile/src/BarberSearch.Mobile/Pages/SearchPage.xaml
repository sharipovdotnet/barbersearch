<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:search="clr-namespace:BarberSearch.Contracts.BarberProfiles.SearchBarbers;assembly=BarberSearch.Contracts"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:SearchViewModel"
    Title="Поиск">

    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry
                Placeholder="Город"
                ReturnCommand="{Binding SearchCommand}"
                Text="{Binding City}" />
            <Button
                Grid.Column="1"
                Command="{Binding SearchCommand}"
                Text="Найти" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
            <Label
                IsVisible="{Binding HasError}"
                LineBreakMode="WordWrap"
                Text="{Binding ErrorMessage}"
                TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
        </VerticalStackLayout>

        <CollectionView
            x:Name="BarbersList"
            Grid.Row="2"
            ItemsSource="{Binding Barbers}"
            SelectionChanged="OnBarberSelected"
            SelectionMode="Single">
            <CollectionView.EmptyView>
                <Label
                    Margin="0,24,0,0"
                    HorizontalTextAlignment="Center"
                    Text="Введите город и нажмите «Найти»"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="search:BarberSearchItemResponse">
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                        StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontFamily="GeistSemiBold"
                                FontSize="16"
                                Text="{Binding DisplayName}" />
                            <Label Text="{Binding PrimarySalonName}" />
                            <Label
                                Text="{Binding City}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label Text="{Binding Rating, StringFormat='Рейтинг: {0}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
