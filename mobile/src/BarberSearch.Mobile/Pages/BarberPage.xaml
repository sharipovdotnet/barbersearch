<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.BarberPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BarberSearch.Mobile.Controls"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:BarberCardViewModel"
    Title="{loc:Translate Key='Мастер'}">

    <Grid>

        <ScrollView x:Name="PageScroll" IsVisible="{Binding IsContentVisible}">
            <VerticalStackLayout Padding="16">

                <!-- Шапка: аватар, имя, грейд, «Проверен», рейтинг, стаж и место приёма. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border
                            WidthRequest="64"
                            HeightRequest="64"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                            StrokeShape="RoundRectangle 32"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                            <Grid>
                                <Image
                                    Aspect="AspectFill"
                                    IsVisible="{Binding HasAvatar}"
                                    Source="{Binding AvatarImageUrl}" />
                                <Label
                                    FontFamily="GeistSemiBold"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding ShowInitials}"
                                    Text="{Binding Initials}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label
                                FontFamily="GeistSemiBold"
                                FontSize="22"
                                LineBreakMode="WordWrap"
                                Text="{Binding DisplayName}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label
                                    Text="{Binding GradeText}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                <Border
                                    Padding="8,2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                    IsVisible="{Binding IsVerified}"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="0">
                                    <Label FontSize="12" Text="{loc:Translate Key='Проверен'}" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding RatingText}" />
                            <Label
                                FontSize="12"
                                Text="{Binding ExperienceText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                LineBreakMode="WordWrap"
                                Text="{Binding PlaceText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Работы: квадратные плитки в две колонки; пустое портфолио секции не создаёт. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    IsVisible="{Binding HasPhotos}"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout>
                        <Label
                            Margin="0,0,0,8"
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Работы'}" />
                        <controls:PhotoGrid BindableLayout.ItemsSource="{Binding Photos}" ColumnSpacing="8" RowSpacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberPhotoOption">
                                    <Border
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                        SemanticProperties.Description="{Binding AltText}"
                                        SemanticProperties.Hint="{Binding OpenHint}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnPhotoTapped" />
                                        </Border.GestureRecognizers>
                                        <Image Aspect="AspectFill" Source="{Binding TileImageUrl}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </controls:PhotoGrid>
                    </VerticalStackLayout>
                </Border>

                <!--
                    Специализации: название — чип, как у языков и способов оплаты, а описание
                    из справочника открывается тапом и показывается под рядом. На телефоне
                    hover нет, поэтому веб-подсказка заменена тапом; открыта одна подсказка.
                -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    IsVisible="{Binding HasSpecializations}"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout>
                        <Label
                            Margin="0,0,0,8"
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Специализации'}" />

                        <!--
                            Обёртка задаёт цель нажатия не меньше 44 pt: сам чип остаётся
                            компактным и центрируется. Жест висит на обёртке, а не на рамке,
                            иначе палец попадал бы в текст. Чип без описания тап игнорирует —
                            решение принимает ViewModel, у неё же состояние выделения.
                            Отступ только горизонтальный, 4: цель в 44 pt уже даёт 12 pt
                            воздуха по вертикали между рядами, и второй вертикальный отступ
                            раздувал бы блок.
                        -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding Specializations}" Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberSpecializationOption">
                                    <Grid
                                        Margin="0,0,4,0"
                                        FlexLayout.Shrink="0"
                                        MinimumHeightRequest="44"
                                        MinimumWidthRequest="44"
                                        SemanticProperties.Description="{Binding Name}"
                                        SemanticProperties.Hint="{Binding Description}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnSpecializationTapped" />
                                        </Grid.GestureRecognizers>
                                        <Border
                                            Padding="8,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                            HorizontalOptions="Center"
                                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                            <Border.Triggers>
                                                <!-- Выбранное состояние — рамка Primary: рядом ещё и текст описания. -->
                                                <DataTrigger
                                                    Binding="{Binding IsSelected}"
                                                    TargetType="Border"
                                                    Value="True">
                                                    <Setter Property="StrokeThickness" Value="1" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label FontSize="12" Text="{Binding Name}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Описание выбранной специализации: обычный видимый текст, читаемый при обходе. -->
                        <Border
                            Padding="8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                            IsVisible="{Binding HasSelectedSpecializationDescription}"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="0">
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="{Binding SelectedSpecializationDescription}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Услуги: специализация заголовком группы, цена и длительность строкой. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout>
                        <Label
                            Margin="0,0,0,8"
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Услуги'}" />
                        <Label
                            IsVisible="{Binding HasNoServices}"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Услуги пока не добавлены.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <!--
                            Специализация — заголовок группы, а не бейдж на каждой строке: так она
                            читается один раз и не обрезается на узком экране, как в фильтре
                            «Услуга» на «Поиске». Порядок групп задаёт отсортированный прайс.
                        -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ServiceGroups}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberServiceGroup">
                                    <VerticalStackLayout Spacing="8">
                                        <Label
                                            Margin="0,4,0,0"
                                            FontFamily="GeistSemiBold"
                                            FontSize="14"
                                            Text="{Binding Title}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}" Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BarberServiceOption">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <VerticalStackLayout Spacing="2">
                                                            <Label LineBreakMode="WordWrap" Text="{Binding DisplayName}" />
                                                            <FlexLayout
                                                                AlignItems="Center"
                                                                Direction="Row"
                                                                Wrap="Wrap">
                                                                <Border
                                                                    Margin="0,0,8,4"
                                                                    Padding="8,2"
                                                                    BackgroundColor="Transparent"
                                                                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                                                                    StrokeShape="RoundRectangle 8">
                                                                    <Label
                                                                        FontSize="12"
                                                                        Text="{Binding CategoryText}"
                                                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                                                </Border>
                                                                <Label
                                                                    Margin="0,0,8,4"
                                                                    FontSize="12"
                                                                    Text="{Binding DurationText}"
                                                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                                                    VerticalTextAlignment="Center" />
                                                            </FlexLayout>
                                                        </VerticalStackLayout>
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding PriceText}"
                                                            VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Свободное время: салон, услуга, дата, чипы слотов и панель записи. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Margin="0,0,0,8"
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Свободное время'}" />

                        <Label
                            IsVisible="{Binding HasNoSalons}"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Мастер пока не указал место приёма. Онлайн-запись появится, когда место будет добавлено.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <VerticalStackLayout IsVisible="{Binding HasSalons}" Spacing="8">

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="12"
                                        Text="{loc:Translate Key='Услуга'}"
                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                    <Picker
                                        ItemsSource="{Binding ServiceOptions}"
                                        SelectedIndexChanged="OnServiceChanged"
                                        SelectedItem="{Binding SelectedService, Mode=OneWay}"
                                        ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:BarberServiceOption}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        FontSize="12"
                                        Text="{loc:Translate Key='Салон'}"
                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                    <Picker
                                        IsVisible="{Binding HasMultipleSalons}"
                                        ItemsSource="{Binding Salons}"
                                        SelectedIndexChanged="OnSalonChanged"
                                        SelectedItem="{Binding SelectedSalon, Mode=OneWay}"
                                        ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:BarberSalonOption}" />
                                    <Label
                                        IsVisible="{Binding HasSingleSalon}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding SelectedSalon.Name}"
                                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="{loc:Translate Key='Дата'}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                <DatePicker
                                    Date="{Binding SelectedDate, Mode=OneWay}"
                                    DateSelected="OnDateSelected"
                                    Format="dd.MM.yyyy"
                                    MaximumDate="{Binding MaximumDate}"
                                    MinimumDate="{Binding MinimumDate}" />
                            </VerticalStackLayout>

                            <Label FontFamily="GeistMedium" Text="{Binding SelectedDateText}" />

                            <ActivityIndicator
                                HorizontalOptions="Start"
                                IsRunning="{Binding IsSlotsLoading}"
                                IsVisible="{Binding IsSlotsLoading}" />

                            <VerticalStackLayout IsVisible="{Binding HasSlotsError}" Spacing="8">
                                <Label
                                    LineBreakMode="WordWrap"
                                    Text="{Binding SlotsErrorText}"
                                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                                <Label
                                    FontSize="12"
                                    IsVisible="{Binding IsAutoRetrying}"
                                    Text="{loc:Translate Key='Пробуем снова…'}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                <Button
                                    Command="{Binding RetrySlotsCommand}"
                                    HorizontalOptions="Start"
                                    Text="{loc:Translate Key='Повторить'}" />
                            </VerticalStackLayout>

                            <Label
                                IsVisible="{Binding HasEmptySlots}"
                                LineBreakMode="WordWrap"
                                Text="{Binding EmptySlotsText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                            <controls:SlotGrid BindableLayout.ItemsSource="{Binding Slots}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BarberSlotOption">
                                        <Button
                                            Padding="12,8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                            Command="{Binding SelectCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="8"
                                            FontSize="14"
                                            Text="{Binding TimeText}"
                                            TextColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}">
                                            <Button.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSelected}"
                                                    TargetType="Button"
                                                    Value="True">
                                                    <Setter
                                                        Property="BackgroundColor"
                                                        Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource PrimaryForeground}, Dark={StaticResource PrimaryForegroundDark}}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </controls:SlotGrid>

                            <Label
                                IsVisible="{Binding ShowSlotsHint}"
                                LineBreakMode="WordWrap"
                                Text="{loc:Translate Key='Выберите услугу, чтобы записаться.'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                            <!-- Панель записи: сводка, комментарий, отправка и подтверждение. -->
                            <Border
                                IsVisible="{Binding IsBookingPanelVisible}"
                                Padding="12"
                                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                                StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        FontFamily="GeistMedium"
                                        IsVisible="{Binding IsSummaryVisible}"
                                        Text="{loc:Translate Key='Запись на приём'}" />

                                    <VerticalStackLayout IsVisible="{Binding IsSummaryVisible}" Spacing="2">
                                        <Label FontFamily="GeistMedium" Text="{Binding SummaryDateText}" />
                                        <Label
                                            LineBreakMode="WordWrap"
                                            Text="{Binding SummaryServiceText}"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        <Label Text="{Binding SummaryPriceText}" />
                                    </VerticalStackLayout>

                                    <Label
                                        IsVisible="{Binding IsBookingErrorVisible}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding BookingErrorText}"
                                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                                    <VerticalStackLayout IsVisible="{Binding IsSignInVisible}" Spacing="8">
                                        <Label
                                            LineBreakMode="WordWrap"
                                            Text="{Binding SignInText}"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        <Button
                                            Clicked="OnSignInClicked"
                                            MinimumHeightRequest="44"
                                            Text="{loc:Translate Key='Войти'}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout IsVisible="{Binding IsBookFormVisible}" Spacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="12"
                                                Text="{loc:Translate Key='Комментарий (необязательно)'}"
                                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                            <Editor
                                                AutoSize="TextChanges"
                                                MaxLength="500"
                                                MinimumHeightRequest="80"
                                                Text="{Binding CustomerNote}" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding NoteHintText}"
                                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Command="{Binding BookCommand}"
                                            IsEnabled="{Binding IsSubmitEnabled}"
                                            IsVisible="{Binding IsSubmitVisible}"
                                            Text="{Binding SubmitButtonText}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout IsVisible="{Binding IsSuccessVisible}" Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label FontFamily="GeistMedium" Text="{loc:Translate Key='Заявка отправлена'}" />
                                            <Label
                                                Text="{loc:Translate Key='Ждёт подтверждения'}"
                                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            LineBreakMode="WordWrap"
                                            Text="{loc:Translate Key='Мастер подтвердит запись.'}"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        <Button
                                            Command="{Binding BookAgainCommand}"
                                            IsVisible="{Binding IsBookAgainVisible}"
                                            Text="{loc:Translate Key='Записаться ещё раз'}" />
                                    </VerticalStackLayout>

                                    <Button
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                        Command="{Binding ChangeTimeCommand}"
                                        IsVisible="{Binding IsBookingActionsVisible}"
                                        Text="{Binding SecondaryButtonText}"
                                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Время — местное для салона.'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- О мастере: описание, языки и пять списков в веб-порядке. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    IsVisible="{Binding HasAbout}"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='О мастере'}" />

                        <Label
                            IsVisible="{Binding HasBio}"
                            LineBreakMode="WordWrap"
                            Text="{Binding Bio}" />

                        <VerticalStackLayout IsVisible="{Binding HasLanguages}" Spacing="6">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Языки'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding LanguageChips}" Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Margin="0,0,8,8"
                                            Padding="8,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                            FlexLayout.Shrink="0"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="0">
                                            <Label FontSize="12" Text="{Binding .}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AboutLists}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberInfoList">
                                    <VerticalStackLayout Spacing="6">
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Title}"
                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BarberInfoItem">
                                                    <Label
                                                        FontSize="14"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding Text}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Оплата: способы оплаты чипами в порядке сервера. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    IsVisible="{Binding HasPayments}"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout>
                        <Label
                            Margin="0,0,0,8"
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Оплата'}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding PaymentChips}" Wrap="Wrap">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border
                                        Margin="0,0,8,8"
                                        Padding="8,4"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                                        FlexLayout.Shrink="0"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <Label FontSize="12" Text="{Binding .}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Правила визита: правило опозданий. -->
                <Border
                    Margin="0,0,0,12"
                    Padding="16"
                    IsVisible="{Binding HasLatePolicy}"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout>
                        <Label
                            Margin="0,0,0,8"
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Правила визита'}" />
                        <Label
                            LineBreakMode="WordWrap"
                            Text="{Binding LatePolicyText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Отзывы: сводка из профиля, страница строк, ошибки и пагинатор. -->
                <Border
                    x:Name="ReviewsSection"
                    Margin="0,0,0,12"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Отзывы'}" />

                        <Label
                            FontFamily="GeistMedium"
                            IsVisible="{Binding Reviews.HasSummary}"
                            Text="{Binding Reviews.SummaryText}" />

                        <ActivityIndicator
                            HorizontalOptions="Start"
                            IsRunning="{Binding Reviews.IsFirstLoading}"
                            IsVisible="{Binding Reviews.IsFirstLoading}" />

                        <VerticalStackLayout IsVisible="{Binding Reviews.HasFirstError}" Spacing="8">
                            <Label
                                LineBreakMode="WordWrap"
                                Text="{Binding Reviews.FirstErrorText}"
                                TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                            <Label
                                FontSize="12"
                                IsVisible="{Binding Reviews.IsAutoRetrying}"
                                Text="{loc:Translate Key='Пробуем снова…'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Button
                                Command="{Binding Reviews.RetryFirstPageCommand}"
                                HorizontalOptions="Start"
                                Text="{loc:Translate Key='Повторить'}" />
                        </VerticalStackLayout>

                        <Label
                            IsVisible="{Binding Reviews.IsEmpty}"
                            Text="{loc:Translate Key='Пока нет отзывов.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <Label
                            IsVisible="{Binding Reviews.IsPageEmpty}"
                            Text="{loc:Translate Key='На этой странице отзывов нет.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reviews.Items}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberReviewItem">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <Label
                                                Text="{Binding Stars}"
                                                TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="GeistMedium"
                                                Text="{Binding RatingText}" />
                                            <Label
                                                Grid.Column="2"
                                                FontSize="12"
                                                HorizontalTextAlignment="End"
                                                Text="{Binding DateText}"
                                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                        </Grid>
                                        <Label LineBreakMode="WordWrap" Text="{Binding BodyText}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding HasText}"
                                                    TargetType="Label"
                                                    Value="False">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding Reviews.IsPagerVisible}" Spacing="8">
                            <Label
                                IsVisible="{Binding Reviews.HasPageError}"
                                LineBreakMode="WordWrap"
                                Text="{Binding Reviews.PageErrorText}"
                                TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                            <Label
                                FontSize="12"
                                IsVisible="{Binding Reviews.IsAutoRetrying}"
                                Text="{loc:Translate Key='Пробуем снова…'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Button
                                    Command="{Binding Reviews.PreviousPageCommand}"
                                    IsEnabled="{Binding Reviews.CanGoPrevious}"
                                    MinimumHeightRequest="44"
                                    Text="{loc:Translate Key='Назад'}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding Reviews.PageRangeText}"
                                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                                    VerticalOptions="Center" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding Reviews.NextPageCommand}"
                                    IsEnabled="{Binding Reviews.CanGoNext}"
                                    MinimumHeightRequest="44"
                                    Text="{Binding Reviews.NextPageButtonText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center" />

        <VerticalStackLayout
            IsVisible="{Binding IsNotFound}"
            Padding="24"
            Spacing="8"
            VerticalOptions="Center">
            <Label
                FontFamily="GeistSemiBold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Text="{loc:Translate Key='Мастер не найден'}" />
            <Label
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Возможно, профиль скрыт или ссылка устарела.'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
        </VerticalStackLayout>

        <VerticalStackLayout
            IsVisible="{Binding HasLoadError}"
            Padding="24"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding LoadErrorText}" />
            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsAutoRetrying}"
                Text="{loc:Translate Key='Пробуем снова…'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            <Button Command="{Binding RetryLoadCommand}" HorizontalOptions="Center" Text="{loc:Translate Key='Повторить'}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
