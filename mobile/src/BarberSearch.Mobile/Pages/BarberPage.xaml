<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.BarberPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:BarberCardViewModel"
    Title="Барбер">

    <ContentPage.Resources>

        <!-- Карточка-секция: та же рамка, что у строки поиска, без новых радиусов. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Stroke" Value="{StaticResource Gray200}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MetaText" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
        </Style>

        <!-- Чип слота: цель нажатия 44 pt, выбор подсвечивается акцентом. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
            <Setter Property="TextColor" Value="{StaticResource Black}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- Второстепенная кнопка: нейтральный фон вместо акцентного. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
            <Setter Property="TextColor" Value="{StaticResource Black}" />
        </Style>

    </ContentPage.Resources>

    <Grid>

        <ScrollView IsVisible="{Binding IsContentVisible}">
            <VerticalStackLayout Padding="16">

                <!-- Шапка: имя, грейд, рейтинг и место приёма. Аватара в срезе нет. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontAttributes="Bold"
                            FontSize="22"
                            LineBreakMode="WordWrap"
                            Text="{Binding DisplayName}" />
                        <Label Text="{Binding GradeText}" TextColor="{StaticResource Gray500}" />
                        <Label Text="{Binding RatingText}" />
                        <Label
                            LineBreakMode="WordWrap"
                            Text="{Binding PlaceText}"
                            TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Услуги: цена и длительность, без кнопок записи. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout>
                        <Label Style="{StaticResource SectionTitle}" Text="Услуги" />
                        <Label
                            IsVisible="{Binding HasNoServices}"
                            LineBreakMode="WordWrap"
                            Text="Услуги пока не добавлены."
                            TextColor="{StaticResource Gray500}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarberServiceOption">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label LineBreakMode="WordWrap" Text="{Binding Name}" />
                                            <Label Style="{StaticResource MetaText}" Text="{Binding DurationText}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding PriceText}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Свободное время: салон, услуга, дата, чипы слотов и панель записи. -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="Свободное время" />

                        <Label
                            IsVisible="{Binding HasNoSalons}"
                            LineBreakMode="WordWrap"
                            Text="Барбер пока не указал место приёма. Онлайн-запись появится, когда место будет добавлено."
                            TextColor="{StaticResource Gray500}" />

                        <VerticalStackLayout IsVisible="{Binding HasSalons}" Spacing="8">

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource MetaText}" Text="Услуга" />
                                    <Picker
                                        ItemsSource="{Binding ServiceOptions}"
                                        SelectedIndexChanged="OnServiceChanged"
                                        SelectedItem="{Binding SelectedService, Mode=OneWay}"
                                        ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:BarberServiceOption}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Style="{StaticResource MetaText}" Text="Салон" />
                                    <Picker
                                        IsVisible="{Binding HasMultipleSalons}"
                                        ItemsSource="{Binding Salons}"
                                        SelectedIndexChanged="OnSalonChanged"
                                        SelectedItem="{Binding SelectedSalon, Mode=OneWay}"
                                        ItemDisplayBinding="{Binding DisplayText, x:DataType=vm:BarberSalonOption}" />
                                    <Label
                                        IsVisible="{Binding HasSingleSalon}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding SelectedSalon.Name}"
                                        TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource MetaText}" Text="Дата" />
                                <DatePicker
                                    Date="{Binding SelectedDate, Mode=OneWay}"
                                    DateSelected="OnDateSelected"
                                    Format="dd.MM.yyyy"
                                    MaximumDate="{Binding MaximumDate}"
                                    MinimumDate="{Binding MinimumDate}" />
                            </VerticalStackLayout>

                            <Label FontAttributes="Bold" Text="{Binding SelectedDateText}" />

                            <ActivityIndicator
                                HorizontalOptions="Start"
                                IsRunning="{Binding IsSlotsLoading}"
                                IsVisible="{Binding IsSlotsLoading}" />

                            <VerticalStackLayout IsVisible="{Binding HasSlotsError}" Spacing="8">
                                <Label
                                    LineBreakMode="WordWrap"
                                    Text="{Binding SlotsErrorText}"
                                    TextColor="{StaticResource Danger}" />
                                <Button
                                    Command="{Binding RetrySlotsCommand}"
                                    HorizontalOptions="Start"
                                    Text="Повторить" />
                            </VerticalStackLayout>

                            <Label
                                IsVisible="{Binding HasEmptySlots}"
                                LineBreakMode="WordWrap"
                                Text="{Binding EmptySlotsText}"
                                TextColor="{StaticResource Gray500}" />

                            <FlexLayout BindableLayout.ItemsSource="{Binding Slots}" Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BarberSlotOption">
                                        <Button
                                            Command="{Binding SelectCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource ChipButton}"
                                            Text="{Binding TimeText}">
                                            <Button.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSelected}"
                                                    TargetType="Button"
                                                    Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Label
                                IsVisible="{Binding ShowSlotsHint}"
                                LineBreakMode="WordWrap"
                                Text="Выберите услугу, чтобы записаться."
                                TextColor="{StaticResource Gray500}" />

                            <!-- Панель записи: сводка, комментарий, отправка и подтверждение. -->
                            <Border
                                IsVisible="{Binding IsBookingPanelVisible}"
                                Padding="12"
                                Stroke="{StaticResource Gray200}"
                                StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        IsVisible="{Binding IsSummaryVisible}"
                                        Text="Запись на приём" />

                                    <VerticalStackLayout IsVisible="{Binding IsSummaryVisible}" Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding SummaryDateText}" />
                                        <Label
                                            LineBreakMode="WordWrap"
                                            Text="{Binding SummaryServiceText}"
                                            TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding SummaryPriceText}" />
                                    </VerticalStackLayout>

                                    <Label
                                        IsVisible="{Binding IsBookingErrorVisible}"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding BookingErrorText}"
                                        TextColor="{StaticResource Danger}" />

                                    <VerticalStackLayout IsVisible="{Binding IsSignInVisible}" Spacing="8">
                                        <Label
                                            LineBreakMode="WordWrap"
                                            Text="{Binding SignInText}"
                                            TextColor="{StaticResource Gray500}" />
                                        <Button
                                            Clicked="OnSignInClicked"
                                            MinimumHeightRequest="44"
                                            Text="Войти" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout IsVisible="{Binding IsBookFormVisible}" Spacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Style="{StaticResource MetaText}" Text="Комментарий (необязательно)" />
                                            <Editor
                                                AutoSize="TextChanges"
                                                MaxLength="500"
                                                MinimumHeightRequest="80"
                                                Text="{Binding CustomerNote}" />
                                            <Label Style="{StaticResource MetaText}" Text="{Binding NoteHintText}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Command="{Binding BookCommand}"
                                            IsEnabled="{Binding IsSubmitEnabled}"
                                            IsVisible="{Binding IsSubmitVisible}"
                                            Text="{Binding SubmitButtonText}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout IsVisible="{Binding IsSuccessVisible}" Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label FontAttributes="Bold" Text="Заявка отправлена" />
                                            <Label Text="Ждёт подтверждения" TextColor="{StaticResource Gray500}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            LineBreakMode="WordWrap"
                                            Text="Барбер подтвердит запись."
                                            TextColor="{StaticResource Gray500}" />
                                        <Button
                                            Command="{Binding BookAgainCommand}"
                                            IsVisible="{Binding IsBookAgainVisible}"
                                            Text="Записаться ещё раз" />
                                    </VerticalStackLayout>

                                    <Button
                                        Command="{Binding ChangeTimeCommand}"
                                        IsVisible="{Binding IsBookingActionsVisible}"
                                        Style="{StaticResource SecondaryButton}"
                                        Text="{Binding SecondaryButtonText}" />
                                </VerticalStackLayout>
                            </Border>

                            <Label
                                Style="{StaticResource MetaText}"
                                Text="Время — местное для салона." />

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center" />

        <VerticalStackLayout
            IsVisible="{Binding IsNotFound}"
            Padding="24"
            Spacing="8"
            VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Text="Барбер не найден" />
            <Label
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="Возможно, профиль скрыт или ссылка устарела."
                TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <VerticalStackLayout
            IsVisible="{Binding HasLoadError}"
            Padding="24"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding LoadErrorText}" />
            <Button HorizontalOptions="Center" Text="Повторить" Command="{Binding RetryLoadCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
