<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.TabBarIsVisible="False"
    Title="Восстановление пароля">

    <!--
        Запрос ссылки для сброса забытого пароля. Повторяет веб-страницу
        frontend/src/pages/forgot-password-page.tsx: одно поле, карточка «Проверьте почту»
        и локальный кулдаун повторной отправки. Приложение только просит письмо — ссылка
        из него открывает веб-страницу сброса, поэтому формы нового пароля здесь нет.
    -->
    <Grid Padding="16">

        <ScrollView IsVisible="{Binding ShowForm}">
            <VerticalStackLayout Padding="0,0,0,24" Spacing="8">

                <Label
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    Text="Укажите email аккаунта — мы отправим ссылку для сброса пароля."
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <Label Text="Email" />
                <Entry
                    IsEnabled="{Binding IsFormEnabled}"
                    Keyboard="Email"
                    MinimumHeightRequest="44"
                    Placeholder="you@example.com"
                    ReturnCommand="{Binding SendCommand}"
                    ReturnType="Go"
                    Text="{Binding Email}" />
                <Label
                    FontSize="12"
                    IsVisible="{Binding HasEmailError}"
                    LineBreakMode="WordWrap"
                    Text="{Binding EmailError}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                <Label
                    IsVisible="{Binding HasFormError}"
                    LineBreakMode="WordWrap"
                    Text="{Binding FormError}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                <Button
                    Margin="0,8,0,0"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsFormEnabled}"
                    MinimumHeightRequest="44"
                    Text="{Binding SendButtonText}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Ссылка запрошена: адрес не подтверждается сервером, карточка не различает случаи. -->
        <ScrollView IsVisible="{Binding ShowSentCard}">
            <VerticalStackLayout Padding="0,0,0,24" Spacing="12">

                <Label
                    FontFamily="GeistSemiBold"
                    FontSize="20"
                    Text="Проверьте почту" />
                <Label
                    LineBreakMode="WordWrap"
                    Text="{Binding SentDescription}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                <Label
                    LineBreakMode="WordWrap"
                    Text="Письма нет? Проверьте папку «Спам» или запросите ссылку ещё раз."
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <Label
                    IsVisible="{Binding HasFormError}"
                    LineBreakMode="WordWrap"
                    Text="{Binding FormError}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                    Command="{Binding ResendCommand}"
                    IsEnabled="{Binding CanResend}"
                    MinimumHeightRequest="44"
                    Text="{Binding ResendButtonText}"
                    TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />

                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding ChangeEmailCommand}"
                    MinimumHeightRequest="44"
                    Text="Указать другой адрес"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
