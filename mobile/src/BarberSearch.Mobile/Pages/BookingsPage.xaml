<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.BookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Записи">

    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
        <Label
            FontFamily="GeistSemiBold"
            FontSize="20"
            HorizontalTextAlignment="Center"
            Text="Мои записи" />
        <Label
            HorizontalTextAlignment="Center"
            Text="Список записей появится после подключения авторизации."
            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
    </VerticalStackLayout>

</ContentPage>
