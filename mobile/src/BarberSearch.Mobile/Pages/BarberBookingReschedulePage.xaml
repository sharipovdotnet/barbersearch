<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.BarberBookingReschedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    xmlns:vmbarber="clr-namespace:BarberSearch.Mobile.Core.ViewModels.Barber;assembly=BarberSearch.Mobile.Core"
    x:DataType="vmbarber:BarberBookingRescheduleViewModel"
    Shell.TabBarIsVisible="False"
    Title="{loc:Translate Key='Перенести запись'}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Текущий визит: перенос меняет только время, услуга и цена остаются. -->
            <Border
                Padding="12"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding CustomerName}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding MomentText}" />
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding ServiceSalonText}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    <Label
                        FontSize="12"
                        LineBreakMode="WordWrap"
                        Text="{loc:Translate Key='Длительность и цена не изменятся'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Дата: границы посчитаны в поясе салона, смена даты перечитывает сетку. -->
            <VerticalStackLayout Spacing="4">
                <Label
                    FontSize="12"
                    Text="{loc:Translate Key='Дата'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                <DatePicker
                    Date="{Binding SelectedDate, Mode=TwoWay}"
                    Format="D"
                    MaximumDate="{Binding MaximumDate}"
                    MinimumDate="{Binding MinimumDate}" />
            </VerticalStackLayout>

            <!-- Свободное время выбранной даты. -->
            <VerticalStackLayout Spacing="8">
                <Label
                    FontFamily="GeistSemiBold"
                    FontSize="16"
                    Text="{loc:Translate Key='Свободное время'}" />

                <ActivityIndicator
                    HorizontalOptions="Start"
                    IsRunning="{Binding IsLoadingSlots}"
                    IsVisible="{Binding IsLoadingSlots}" />

                <!-- Ошибка сетки: причина и строка автоповтора. -->
                <VerticalStackLayout IsVisible="{Binding ShowSlotsError}" Spacing="8">
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding SlotsError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Label
                        FontSize="12"
                        IsVisible="{Binding IsAutoRetrying}"
                        Text="{loc:Translate Key='Пробуем снова…'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>

                <Label
                    IsVisible="{Binding ShowEmptyDay}"
                    LineBreakMode="WordWrap"
                    Text="{Binding EmptyDayText}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <FlexLayout
                    IsVisible="{Binding ShowSlots}"
                    BindableLayout.ItemsSource="{Binding Slots}"
                    Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BarberSlotOption">
                            <Button
                                Margin="0,0,8,8"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                                Command="{Binding SelectCommand}"
                                CommandParameter="{Binding .}"
                                CornerRadius="8"
                                FontSize="14"
                                Text="{Binding TimeText}"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSelected}"
                                        TargetType="Button"
                                        Value="True">
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter
                                            Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource PrimaryForeground}, Dark={StaticResource PrimaryForegroundDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Label
                IsVisible="{Binding HasError}"
                LineBreakMode="WordWrap"
                Text="{Binding ErrorMessage}"
                TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

            <Button
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding CanSubmit}"
                Text="{Binding SubmitText}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
