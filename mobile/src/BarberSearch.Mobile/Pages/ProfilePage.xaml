<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:theming="clr-namespace:BarberSearch.Mobile.Theming"
    xmlns:controls="clr-namespace:BarberSearch.Mobile.Controls"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:ProfileViewModel"
    Title="{loc:Translate Key='Профиль'}">

    <!-- Заголовок навигации: ножницы перед названием раздела, как логотип в шапке веба. -->
    <Shell.TitleView>
        <controls:BrandTitleView Text="{loc:Translate Key='Профиль'}" />
    </Shell.TitleView>

    <!--
        Вкладка «Профиль» — хаб: без сессии форма входа, с сессией карточка личности и
        переходы в разделы. Состояния лежат в одной ячейке сетки и показываются
        взаимоисключающе: так ни одно из них не толкает остальные.

        Текст на этой вкладке на одну ступень крупнее остального приложения: body 16 вместо 14,
        meta 14 вместо 12, шкала та же. «Профиль» — место, где живёт самый мелкий текст
        приложения (статус email, роль, подпись напоминаний), и люди с плохим зрением не
        могут его прочитать; отклонение записано в AGENT.md §5.
    -->
    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="8">

        <!--
            Переключатели темы и языка стоят на вкладке «Профиль»: язык в вебе живёт в шапке,
            а переключателя темы там пока нет; на телефоне «Профиль» — единственный экран
            настроек. Смена языка пересобирает Shell, смена темы — нет: AppThemeBinding
            перекрашивает страницы на месте. FlexLayout переносит пару на вторую строку на
            узком экране вместо обрезки.
        -->
        <FlexLayout
            Grid.Row="0"
            AlignItems="Center"
            Direction="Row"
            JustifyContent="End"
            Wrap="Wrap">
            <theming:ThemeSwitcher x:Name="ThemeSwitch" Margin="0,0,8,0" />
            <loc:LanguageSwitcher />
        </FlexLayout>

        <Grid Grid.Row="1">

        <ScrollView IsVisible="{Binding IsFormVisible}">
            <VerticalStackLayout Padding="0,24,0,0" Spacing="12">

                <!--
                    Вход начинается со знака бренда: тот же логотип, что на поиске, но
                    компактнее — плашка 40 и заголовок рядом, чтобы форма не открывалась
                    голой строкой на пустом экране.
                -->
                <HorizontalStackLayout Spacing="12">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        HeightRequest="40"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 8"
                        VerticalOptions="Center"
                        WidthRequest="40">
                        <controls:ScissorsMark StrokeColor="{AppThemeBinding Light={StaticResource PrimaryForeground}, Dark={StaticResource PrimaryForegroundDark}}" />
                    </Border>
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="22"
                        Text="{loc:Translate Key='Вход в Hairo'}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label FontSize="16" Text="Email" />
                    <Entry
                        IsEnabled="{Binding IsFormEnabled}"
                        Keyboard="Email"
                        MinimumHeightRequest="44"
                        Text="{Binding Email}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label FontSize="16" Text="{loc:Translate Key='Пароль'}" />
                    <Entry
                        IsEnabled="{Binding IsFormEnabled}"
                        IsPassword="True"
                        MinimumHeightRequest="44"
                        ReturnCommand="{Binding LoginCommand}"
                        Text="{Binding Password}" />
                </VerticalStackLayout>

                <Label
                    FontSize="16"
                    IsVisible="{Binding HasError}"
                    LineBreakMode="WordWrap"
                    Text="{Binding ErrorMessage}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                <!-- Ссылка стоит между ошибкой входа и кнопкой, как в диалоге входа веба. -->
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding ForgotPasswordCommand}"
                    FontSize="16"
                    HorizontalOptions="End"
                    MinimumHeightRequest="44"
                    Text="{loc:Translate Key='Забыли пароль?'}"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Button
                    Command="{Binding LoginCommand}"
                    FontSize="16"
                    IsEnabled="{Binding IsFormEnabled}"
                    MinimumHeightRequest="44"
                    Text="{Binding LoginButtonText}" />

                <!-- Регистрация — отдельная страница поверх стека: ссылка стоит под входом,
                     как в диалоге входа веба («Нет аккаунта? Зарегистрироваться»). -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="4">
                    <Label
                        FontSize="16"
                        Text="{loc:Translate Key='Нет аккаунта?'}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}"
                        VerticalTextAlignment="Center" />
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding RegisterCommand}"
                        FontSize="16"
                        HorizontalOptions="Start"
                        Text="{loc:Translate Key='Зарегистрироваться'}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!--
            Загрузка — одна окружность на весь экран: проверка сессии и первая загрузка
            профиля идут подряд, и отдельный спиннер профиля оказывался на экране вместе с
            общим, из-за чего две окружности пересекались. Подпись появляется только тогда,
            когда читается профиль: до ответа о сессии обещать «Загружаем профиль…» нечего.
        -->
        <VerticalStackLayout
            IsVisible="{Binding ShowLoading}"
            Spacing="8"
            VerticalOptions="Center">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding ShowLoading}" />
            <Label
                FontSize="16"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsProfileLoading}"
                Text="{loc:Translate Key='Загружаем профиль…'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
        </VerticalStackLayout>

        <!-- Профиль не загрузился, показать нечего: ошибка и повтор. -->
        <VerticalStackLayout
            IsVisible="{Binding ShowProfileError}"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontFamily="GeistSemiBold"
                FontSize="18"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Не удалось загрузить профиль'}" />
            <Label
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding ProfileError}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            <Button
                Command="{Binding RetryProfileCommand}"
                FontSize="16"
                HorizontalOptions="Center"
                Text="{loc:Translate Key='Повторить'}" />
        </VerticalStackLayout>

        <ScrollView IsVisible="{Binding IsProfileVisible}">
            <VerticalStackLayout Spacing="12">

                <!-- Карточка личности: инициалы вместо аватара, имя, email, роль, статус. -->
                <Border
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                            HeightRequest="56"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 10"
                            VerticalOptions="Start"
                            WidthRequest="56">
                            <Label
                                FontFamily="GeistSemiBold"
                                FontSize="22"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Initials}"
                                TextColor="{AppThemeBinding Light={StaticResource Foreground}, Dark={StaticResource ForegroundDark}}"
                                VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                FontFamily="GeistSemiBold"
                                FontSize="18"
                                LineBreakMode="TailTruncation"
                                Text="{Binding DisplayName}" />
                            <Label
                                FontSize="16"
                                LineBreakMode="TailTruncation"
                                Text="{Binding ProfileEmail}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                FontSize="14"
                                Text="{Binding RoleText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label FontSize="14" Text="{Binding EmailStatusText}">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsEmailVerified}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter
                                            Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsEmailVerified}"
                                        TargetType="Label"
                                        Value="False">
                                        <Setter
                                            Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Предупреждение о неподтверждённом адресе: нажатие ведёт в «Безопасность». -->
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding SecurityCommand}"
                    FontSize="16"
                    HorizontalOptions="Start"
                    IsVisible="{Binding ShowEmailWarning}"
                    Padding="0"
                    Text="{loc:Translate Key='Email не подтверждён'}"
                    TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />

                <!-- Ошибка тихого обновления: данные на экране остаются, есть чем повторить. -->
                <VerticalStackLayout IsVisible="{Binding HasProfileError}" Spacing="8">
                    <Label
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        Text="{Binding ProfileError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Button
                        Command="{Binding RetryProfileCommand}"
                        FontSize="16"
                        HorizontalOptions="Start"
                        Text="{loc:Translate Key='Повторить'}" />
                </VerticalStackLayout>

                <!--
                    Напоминания о записях. Строка существует только когда push действительно
                    настроен (есть push.json): без конфигурации Firebase приложение не обещает
                    настройку, которой нет, и не просит разрешений.
                -->
                <VerticalStackLayout IsVisible="{Binding IsPushConfigured}" Spacing="4">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12"
                        MinimumHeightRequest="44">
                        <Label
                            FontSize="16"
                            Text="{loc:Translate Key='Присылать напоминания'}"
                            VerticalTextAlignment="Center" />
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding NotificationsEnabled, Mode=OneWay}"
                            Toggled="OnNotificationsToggled"
                            VerticalOptions="Center" />
                    </Grid>
                    <Label
                        FontSize="14"
                        IsVisible="{Binding HasNotificationsStatus}"
                        LineBreakMode="WordWrap"
                        Text="{Binding NotificationsStatusText}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding OpenNotificationSettingsCommand}"
                        FontSize="16"
                        HorizontalOptions="Start"
                        IsVisible="{Binding ShowNotificationSettings}"
                        MinimumHeightRequest="44"
                        Text="{loc:Translate Key='Открыть настройки'}"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </VerticalStackLayout>

                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                    Command="{Binding EditProfileCommand}"
                    FontSize="16"
                    Text="{loc:Translate Key='Личные данные'}"
                    TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                    Command="{Binding ReviewsCommand}"
                    FontSize="16"
                    Text="{loc:Translate Key='Мои отзывы'}"
                    TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                    Command="{Binding SecurityCommand}"
                    FontSize="16"
                    Text="{loc:Translate Key='Безопасность'}"
                    TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                    Command="{Binding LogoutCommand}"
                    FontSize="16"
                    Text="{Binding LogoutButtonText}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

            </VerticalStackLayout>
        </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
