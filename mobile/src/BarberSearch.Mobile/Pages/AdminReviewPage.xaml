<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.AdminReviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels.Admin;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:AdminReviewViewModel"
    Shell.TabBarIsVisible="False"
    Title="{loc:Translate Key='Отзыв'}">

    <!--
        Карточка отзыва админки: сначала запись целиком, потом решение.

        Порядок повторяет веб: статус, оценка, текст, мастер, клиент, визит и моменты.
        Решение живёт в нижней полосе, в зоне большого пальца: «Скрыть» слева вторичной
        кнопкой, «Опубликовать» справа основной. «Скрыть» сначала открывает панель причины
        над полосой — замену модального диалога веба; сервер причину не принимает, поэтому
        подтверждение в панели доступно сразу.

        После успешного решения страница закрывается: очередь перечитывается при появлении,
        и разрешённая строка исчезает сама.
    -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView
            Grid.Row="0"
            Padding="16"
            IsVisible="{Binding ShowContent}">
            <VerticalStackLayout Spacing="16">

                <!-- Статус: у опубликованного — Success, у ждущего решения — Muted. -->
                <Border
                    Padding="8,2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                    HorizontalOptions="End"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8">
                    <Border.Triggers>
                        <DataTrigger
                            Binding="{Binding IsPublished}"
                            TargetType="Border"
                            Value="True">
                            <Setter
                                Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="12" Text="{Binding StatusText}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsPublished}"
                                TargetType="Label"
                                Value="True">
                                <Setter
                                    Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource PrimaryForeground}, Dark={StaticResource PrimaryForegroundDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Оценка: крупное число и звёзды, как в вебе. -->
                <HorizontalStackLayout Spacing="12">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="40"
                        Text="{Binding Rating}"
                        VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            FontSize="16"
                            Text="{Binding Stars}"
                            TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                        <Label
                            FontSize="12"
                            Text="{Binding RatingText}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Текст клиента: как есть, с переводами строк; пустой — подпись веба. -->
                <Label
                    FontSize="16"
                    IsVisible="{Binding HasReviewText}"
                    LineBreakMode="WordWrap"
                    Text="{Binding ReviewBody}" />
                <Label
                    FontSize="14"
                    IsVisible="{Binding IsReviewTextEmpty}"
                    LineBreakMode="WordWrap"
                    Text="{loc:Translate Key='Клиент поставил оценку без комментария.'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!-- Контекст: мастер, клиент, визит и моменты. -->
                <Border
                    Padding="12"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Мастер'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                FontFamily="GeistMedium"
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                Text="{Binding BarberName}" />
                            <Label
                                FontSize="12"
                                IsVisible="{Binding HasBarberFlags}"
                                LineBreakMode="WordWrap"
                                Text="{Binding BarberFlagsText}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Клиент'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                FontFamily="GeistMedium"
                                FontSize="15"
                                LineBreakMode="WordWrap"
                                Text="{Binding CustomerName}" />
                            <Label
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                Text="{Binding CustomerEmail}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Визит'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding VisitLine}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Отзыв оставлен'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding CreatedAtText}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding HasUpdatedAt}" Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Изменён'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{Binding UpdatedAtText}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Что будет с рейтингом мастера: слова веба, без иконок. -->
                <Border
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            Text="{Binding BarberSummary}" />
                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="{Binding ModerationHint}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Первая загрузка: индикатор вместо карточки. -->
        <VerticalStackLayout
            Grid.Row="0"
            IsVisible="{Binding IsFirstLoading}"
            Spacing="8"
            VerticalOptions="Center">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsFirstLoading}" />
            <Label
                HorizontalTextAlignment="Center"
                Text="{loc:Translate Key='Загружаем отзыв…'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
        </VerticalStackLayout>

        <!-- Сбой чтения: причина и повтор. -->
        <VerticalStackLayout
            Grid.Row="0"
            IsVisible="{Binding ShowError}"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontFamily="GeistSemiBold"
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Не удалось загрузить отзыв'}" />
            <Label
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{Binding ErrorMessage}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsAutoRetrying}"
                Text="{loc:Translate Key='Пробуем снова…'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            <Button
                Command="{Binding RetryCommand}"
                HorizontalOptions="Center"
                Text="{loc:Translate Key='Повторить'}" />
        </VerticalStackLayout>

        <!-- Роль не администратор: повторять нечего, данные не запрашиваются. -->
        <VerticalStackLayout
            Grid.Row="0"
            IsVisible="{Binding ShowForbidden}"
            Spacing="8"
            VerticalOptions="Center">
            <Label
                FontFamily="GeistSemiBold"
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Раздел доступен только администратору'}" />
            <Label
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='У вашей учётной записи нет прав администратора. Если доступ нужен, обратитесь к владельцу сервиса.'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
        </VerticalStackLayout>

        <!-- Отзыв уже разобрали: повторять нечего, возврат к очереди. -->
        <VerticalStackLayout
            Grid.Row="0"
            IsVisible="{Binding ShowNotFound}"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontFamily="GeistSemiBold"
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Этот отзыв уже разобрали'}" />
            <Label
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Возможно, его опубликовал другой администратор. Вернитесь к очереди — она обновится.'}"
                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            <Button
                Clicked="OnBackToQueueClicked"
                HorizontalOptions="Center"
                Text="{loc:Translate Key='К очереди'}" />
        </VerticalStackLayout>

        <!-- Сессия кончилась: возврат на «Профиль», где стоит форма входа. -->
        <VerticalStackLayout
            Grid.Row="0"
            IsVisible="{Binding ShowSignInRequired}"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontFamily="GeistSemiBold"
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                Text="{loc:Translate Key='Сеанс истёк. Войдите заново.'}" />
            <Button
                Clicked="OnSignInClicked"
                HorizontalOptions="Center"
                Text="{loc:Translate Key='Войти'}" />
        </VerticalStackLayout>

        <!-- Нижняя полоса: решение в зоне большого пальца. -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding ShowContent}">
            <BoxView HeightRequest="1" />

            <VerticalStackLayout Padding="16,12" Spacing="10">

                <Label
                    FontSize="12"
                    IsVisible="{Binding HasActionError}"
                    LineBreakMode="WordWrap"
                    Text="{Binding ActionError}"
                    TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                <!-- Панель причины: необязательный шаг подтверждения вместо диалога веба. -->
                <Border
                    Padding="12"
                    IsVisible="{Binding IsReasonPanelOpen}"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            Text="{loc:Translate Key='Скрыть отзыв?'}" />
                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="{loc:Translate Key='Отзыв исчезнет с карточки мастера, рейтинг пересчитается. Вернуть отзыв можно в любой момент — он появится в очереди модерации.'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Label
                            FontFamily="GeistMedium"
                            FontSize="14"
                            Text="{loc:Translate Key='Причина скрытия (необязательно)'}" />
                        <Border
                            Padding="8"
                            Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                            StrokeShape="RoundRectangle 10">
                            <Editor
                                AutoSize="TextChanges"
                                MinimumHeightRequest="88"
                                Placeholder="{loc:Translate Key='Почему скрываем отзыв'}"
                                Text="{Binding HideReason}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Кнопки панели: отмена слева, подтверждение справа. -->
                <FlexLayout
                    Direction="Row"
                    IsVisible="{Binding IsReasonPanelOpen}">
                    <Button
                        Margin="0,0,8,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Clicked="OnCancelHideClicked"
                        FlexLayout.Grow="1"
                        IsEnabled="{Binding CanAct}"
                        Text="{loc:Translate Key='Отмена'}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Clicked="OnConfirmHideClicked"
                        FlexLayout.Grow="1"
                        IsEnabled="{Binding CanAct}"
                        Text="{Binding HideButtonText}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                </FlexLayout>

                <!-- Полоса решений: «Скрыть» слева, «Опубликовать» справа. -->
                <FlexLayout
                    Direction="Row"
                    IsVisible="{Binding IsNotReasonPanelOpen}">
                    <Button
                        Margin="0,0,8,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Clicked="OnHideClicked"
                        FlexLayout.Grow="1"
                        IsEnabled="{Binding CanAct}"
                        Text="{Binding HideButtonText}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Button
                        Clicked="OnPublishClicked"
                        FlexLayout.Grow="1"
                        IsEnabled="{Binding CanAct}"
                        IsVisible="{Binding ShowPublish}"
                        Text="{Binding PublishButtonText}" />
                </FlexLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
