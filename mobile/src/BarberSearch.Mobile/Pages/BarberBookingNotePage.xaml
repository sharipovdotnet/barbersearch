<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.BarberBookingNotePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels.Barber;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:BarberBookingNoteViewModel"
    Shell.TabBarIsVisible="False"
    Title="{loc:Translate Key='Заметка к записи'}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Визит, к которому относится заметка: имя и момент в поясе салона. -->
            <Border
                Padding="12"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontFamily="GeistSemiBold"
                        FontSize="16"
                        LineBreakMode="TailTruncation"
                        Text="{Binding CustomerName}" />
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding MomentText}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </VerticalStackLayout>
            </Border>

            <!--
                Текст заметки: предел объявлен сервером и повторён в ViewModel.
                MaxLength здесь не задан намеренно — иначе локальная подсказка
                о превышении никогда бы не появилась, а текст молча обрезался.
            -->
            <VerticalStackLayout Spacing="4">
                <Label
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    Text="{loc:Translate Key='Заметку видит только мастер'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                <Border
                    Padding="8"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 10">
                    <Editor
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120"
                        Placeholder="{loc:Translate Key='Например: клиент просил не трогать чёлку'}"
                        Text="{Binding Note}" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label
                        FontSize="12"
                        IsVisible="{Binding IsTooLong}"
                        LineBreakMode="WordWrap"
                        Text="{Binding LengthError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Label
                        Grid.Column="1"
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        Text="{Binding CounterText}"
                        TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                </Grid>
            </VerticalStackLayout>

            <Label
                IsVisible="{Binding HasError}"
                LineBreakMode="WordWrap"
                Text="{Binding ErrorMessage}"
                TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

            <Button
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanSave}"
                Text="{Binding SubmitText}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
