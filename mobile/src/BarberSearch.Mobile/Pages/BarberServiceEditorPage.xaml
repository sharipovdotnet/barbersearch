<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarberSearch.Mobile.Pages.BarberServiceEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:BarberSearch.Mobile.Localization"
    xmlns:vm="clr-namespace:BarberSearch.Mobile.Core.ViewModels.Barber;assembly=BarberSearch.Mobile.Core"
    x:DataType="vm:BarberServiceEditorViewModel"
    Shell.TabBarIsVisible="False"
    Title="{loc:Translate Key='Услуга'}">

    <!--
        Редактор услуги: добавление из справочника или правка цены и длительности.
        Скрытие и возврат услуги остаются в разделе «Профиль»: строка прайса уже несёт
        кнопки «Скрыть»/«Вернуть», и второй путь к тому же действию здесь не нужен.

        Порядок сверху вниз повторяет сам шаг мастера: выбрать услугу (справочник группами
        по специализациям), затем задать цену и длительность. Поэтому карточка выбранной
        услуги стоит над справочником, а не под ним: страница сама прокручивается к ней
        после выбора, и поля не приходится искать в конце длинного списка.
    -->
    <ScrollView x:Name="FormScroll">
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Режим добавления: заголовок и подсказка о двух шагах. -->
            <VerticalStackLayout IsVisible="{Binding IsAddMode}" Spacing="2">
                <Label
                    FontFamily="GeistSemiBold"
                    FontSize="20"
                    Text="{loc:Translate Key='Добавить услугу'}" />
                <Label
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    Text="{loc:Translate Key='Выберите услугу из справочника и задайте свою цену и длительность.'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            </VerticalStackLayout>

            <!-- Режим правки: услуга фиксирована, меняются только цена и длительность. -->
            <VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="2">
                <Label
                    FontFamily="GeistSemiBold"
                    FontSize="20"
                    LineBreakMode="WordWrap"
                    Text="{Binding ServiceName}" />
                <Label
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    Text="{loc:Translate Key='Меняются только цена и длительность. Название задаёт справочник.'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
            </VerticalStackLayout>

            <!--
                Карточка цены и длительности. В добавлении она появляется вместе с выбором
                услуги: пока услуги нет, полям нечего описывать, — и называет выбранное
                направление и длительность по умолчанию, чтобы мастер видел, что именно
                выбирает. В правке карточка стоит всегда: услуга уже названа заголовком экрана.
            -->
            <Border
                x:Name="EditorCard"
                Padding="16"
                IsVisible="{Binding IsFormVisible}"
                Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout IsVisible="{Binding IsAddMode}" Spacing="2">
                        <Label
                            FontSize="12"
                            Text="{loc:Translate Key='Выбрано:'}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                        <Label
                            FontFamily="GeistSemiBold"
                            FontSize="16"
                            LineBreakMode="WordWrap"
                            Text="{Binding SelectedCatalogService.Name}" />
                        <Label
                            FontSize="12"
                            LineBreakMode="WordWrap"
                            Text="{Binding SelectedCatalogService.MetaText}"
                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                    </VerticalStackLayout>

                    <!-- Цена: число с точкой или запятой, не больше двух знаков после. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Цена'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Entry
                                Keyboard="Numeric"
                                Placeholder="0"
                                Text="{Binding PriceText}" />
                        </VerticalStackLayout>

                        <!-- Длительность: от 1 до 1440 минут. -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label
                                FontSize="12"
                                Text="{loc:Translate Key='Длительность, мин'}"
                                TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                            <Entry
                                Keyboard="Numeric"
                                MaxLength="4"
                                Text="{Binding DurationText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Ошибки полей называют поле, поэтому стоят под их парой во всю ширину. -->
                    <Label
                        FontSize="12"
                        IsVisible="{Binding HasPriceError}"
                        LineBreakMode="WordWrap"
                        Text="{Binding PriceError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Label
                        FontSize="12"
                        IsVisible="{Binding HasDurationError}"
                        LineBreakMode="WordWrap"
                        Text="{Binding DurationError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Label
                        IsVisible="{Binding HasFormError}"
                        LineBreakMode="WordWrap"
                        Text="{Binding FormError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            Text="{Binding SaveButtonText}" />
                        <ActivityIndicator
                            Grid.Column="1"
                            IsRunning="{Binding IsSaving}"
                            IsVisible="{Binding IsSaving}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Режим добавления: справочник читается лениво, при открытии формы. -->
            <VerticalStackLayout IsVisible="{Binding IsAddMode}" Spacing="12">

                <ActivityIndicator
                    HorizontalOptions="Start"
                    IsRunning="{Binding IsLoadingCatalog}"
                    IsVisible="{Binding IsLoadingCatalog}" />
                <Label
                    FontSize="12"
                    IsVisible="{Binding IsLoadingCatalog}"
                    Text="{loc:Translate Key='Загружаем каталог…'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!-- Ошибка справочника: чтение по кнопке, автоповтора у формы нет. -->
                <VerticalStackLayout IsVisible="{Binding HasCatalogError}" Spacing="8">
                    <Label
                        LineBreakMode="WordWrap"
                        Text="{Binding CatalogError}"
                        TextColor="{AppThemeBinding Light={StaticResource Destructive}, Dark={StaticResource DestructiveDark}}" />
                    <Button
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDark}}"
                        Command="{Binding RetryCatalogCommand}"
                        HorizontalOptions="Start"
                        Text="{loc:Translate Key='Повторить'}"
                        TextColor="{AppThemeBinding Light={StaticResource SecondaryForeground}, Dark={StaticResource SecondaryForegroundDark}}" />
                </VerticalStackLayout>

                <Label
                    FontSize="12"
                    IsVisible="{Binding IsCatalogEmpty}"
                    LineBreakMode="WordWrap"
                    Text="{loc:Translate Key='Все услуги справочника уже в прайсе.'}"
                    TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />

                <!--
                    Справочник группами по специализациям, как в фильтре «Услуга» на «Поиске»:
                    заголовок называет направление один раз, строки под ним читаются
                    перечислением. Порядок групп задаёт BarberServiceCatalogGroups.
                -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CatalogGroups}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BarberServiceCatalogGroup">
                            <VerticalStackLayout Spacing="8">
                                <Label
                                    Margin="0,8,0,0"
                                    FontFamily="GeistSemiBold"
                                    FontSize="14"
                                    Text="{Binding Title}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BarberServiceCatalogItem">

                                            <!--
                                                Строка справочника. Нажатие выбирает услугу: строка
                                                подсвечивается рамкой, тоном и галочкой, а карточка
                                                цены над списком раскрывается.
                                            -->
                                            <Border
                                                MinimumHeightRequest="44"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 10">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnCatalogServiceTapped" />
                                                </Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsSelected}"
                                                        TargetType="Border"
                                                        Value="True">
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource PrimarySoftDark}}" />
                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <Label
                                                            FontFamily="GeistMedium"
                                                            FontSize="16"
                                                            LineBreakMode="WordWrap"
                                                            Text="{Binding Name}" />
                                                        <Label
                                                            FontSize="12"
                                                            LineBreakMode="WordWrap"
                                                            Text="{Binding MetaText}"
                                                            TextColor="{AppThemeBinding Light={StaticResource MutedForeground}, Dark={StaticResource MutedForegroundDark}}" />
                                                    </VerticalStackLayout>

                                                    <!-- Галочка выбора: тот же lucide «check», что и в остальных знаках. -->
                                                    <Border
                                                        Grid.Column="1"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                        HeightRequest="22"
                                                        IsVisible="{Binding IsSelected}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 11"
                                                        VerticalOptions="Center"
                                                        WidthRequest="22">
                                                        <Image
                                                            HeightRequest="14"
                                                            HorizontalOptions="Center"
                                                            Source="{AppThemeBinding Light=check_light.png, Dark=check_dark.png}"
                                                            VerticalOptions="Center"
                                                            WidthRequest="14" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
